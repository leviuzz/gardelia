{
  "name": "floral-os",
  "version": "0.1.0",
  "private": true,
  "description": "Floral OS — piattaforma SaaS multi-tenant per fioristi (monorepo)",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @floral/web dev",
    "build": "pnpm --filter @floral/web build",
    "start": "pnpm --filter @floral/web start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "pnpm -r run typecheck && tsc -p tsconfig.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:unit": "vitest run --project domain --project web",
    "test:integration": "vitest run --project db --project core",
    "test:e2e": "pnpm --filter @floral/web test:e2e",
    "db:generate": "pnpm --filter @floral/db run generate",
    "db:migrate": "pnpm --filter @floral/db run migrate:dev",
    "db:deploy": "pnpm --filter @floral/db run deploy",
    "db:seed": "pnpm --filter @floral/db run seed",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "lint:fix": "eslint . --fix",
    "platform:assign-plan": "pnpm --filter @floral/core run assign-plan",
    "platform:grant-ai-credits": "pnpm --filter @floral/core run grant-ai-credits",
    "platform:bootstrap-admin": "pnpm --filter @floral/core run bootstrap-admin"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "22.20.5",
    "dotenv": "18.0.10",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.14.0",
    "prettier": "3.10.1",
    "prettier-plugin-tailwindcss": "0.8.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vitest": "5.1.1"
  }
}
