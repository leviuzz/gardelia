# =============================================================================
# Floral OS — variabili d'ambiente (template).
# Copia in `.env` nella root del repo:  cp .env.example .env
# NON committare mai `.env`. I valori qui sotto sono SOLO per sviluppo locale.
# Elenco completo, regole e valori per ambiente: docs/CONFIGURATION.md. All'avvio l'app controlla
# tutto: se qualcosa manca o non torna, non parte ed elenca i problemi.
# =============================================================================

# --- Applicazione -------------------------------------------------------------
# URL pubblico dell'app (link nelle email, redirect auth).
APP_URL=http://localhost:3000
# debug | info | warn | error
LOG_LEVEL=info
# Disattiva la telemetria anonima di Next.js.
NEXT_TELEMETRY_DISABLED=1

# --- Database -------------------------------------------------------------------
# Ruolo RUNTIME: non superuser, non BYPASSRLS, non proprietario delle tabelle.
# L'app si rifiuta di avviarsi in produzione se questo ruolo può bypassare la RLS.
DATABASE_URL=postgresql://floral_app:floral_app_dev@localhost:5432/floral_dev
# Ruolo PROPRIETARIO: usato solo dalle migrazioni (pnpm db:migrate / pnpm db:deploy).
DATABASE_MIGRATION_URL=postgresql://floral_owner:floral_owner_dev@localhost:5432/floral_dev
# Online (Vercel + Neon, docs/DEPLOY_VERCEL.md): DATABASE_URL = URL con pool del ruolo floral_app
# (creato con packages/db/scripts/setup-hosted-db.sql); DATABASE_MIGRATION_URL = URL diretto del
# proprietario, usato solo dalla build di produzione per applicare le migrazioni.
# Dimensione massima del pool di connessioni dell'app (per istanza).
DATABASE_POOL_MAX=10

# Database dei test di integrazione (viene migrato e svuotato dai test).
TEST_DATABASE_URL=postgresql://floral_app:floral_app_dev@localhost:5432/floral_test
TEST_DATABASE_MIGRATION_URL=postgresql://floral_owner:floral_owner_dev@localhost:5432/floral_test

# --- Autenticazione (Better Auth) ----------------------------------------------------
# Segreto per firmare cookie/token. Generalo con:  openssl rand -base64 32
BETTER_AUTH_SECRET=
# Base URL usata da Better Auth (di norma uguale ad APP_URL).
BETTER_AUTH_URL=http://localhost:3000
# Header da cui leggere l'IP reale del client dietro proxy/CDN (rate limiting).
TRUSTED_IP_HEADER=x-forwarded-for
# Login con Google (facoltativo, ADR-036): client OAuth di tipo "Applicazione web" creato in
# Google Cloud Console → API e servizi → Credenziali. URI di reindirizzamento da autorizzare:
#   <APP_URL>/api/auth/callback/google   (in locale: http://localhost:3000/api/auth/callback/google)
# Vanno impostate entrambe o nessuna; senza, il pulsante "Continuar con Google" non compare.
# Un client per ambiente (staging e produzione hanno URL diversi); mai nel repository.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Email ---------------------------------------------------------------------------
# Mittente delle email transazionali.
EMAIL_FROM="Floral OS <no-reply@floralos.localhost>"
# SMTP (in locale: Mailpit di docker-compose, UI su http://localhost:8025).
# Se vuoto in sviluppo, le email vengono SCRITTE NEL LOG del server (non inviate).
# In produzione è obbligatorio: l'app non si avvia senza un provider email.
SMTP_URL=smtp://localhost:1025

# --- Solo hosting (non in questo file) ----------------------------------------------
# Nel progetto Vercel va anche ENABLE_EXPERIMENTAL_COREPACK=1 (la build usa il pnpm del repo);
# nei segreti GitHub PLATFORM_DATABASE_URL per il workflow "Operazioni di piattaforma".
# Elenco: docs/CONFIGURATION.md § "Fuori dall'app".

# --- Seed demo ---------------------------------------------------------------------
# Password degli utenti demo creati da `pnpm db:seed` (solo sviluppo/test).
# Il seed si rifiuta di girare con NODE_ENV=production.
SEED_DEMO_PASSWORD=demo-floral-2026

# --- Anteprime AI del Bouquet Builder (ADR-024, ADR-025) ------------------------------
# Provider delle immagini (ADR-026), che decide anche lo scontorno delle foto (ADR-033):
#   none      → funzioni nascoste (anteprime e scontorno)
#   simulated → SOLO in locale: immagini astratte etichettate "Simulación", scontorno con un
#               algoritmo locale valido solo su fondi lisi; mai in produzione
#   fal       → immagini reali con fal.ai e scontorno con BiRefNet (~0,002 USD a foto)
#               (a pagamento, credito prepagato della piattaforma)
AI_PROVIDER=simulated
# Modello fal (solo con AI_PROVIDER=fal): nano-banana-2 (predefinito) | gpt-image-2.
AI_MODEL=nano-banana-2
# Chiave API di fal.ai (solo con AI_PROVIDER=fal). È un segreto: nelle variabili
# dell'hosting o nel tuo .env locale, mai nel repo. Dietro un proxy che inserisce la chiave
# (es. sessioni cloud di sviluppo) basta un segnaposto.
FAL_KEY=
# Tetto di spesa mensile di TUTTA la piattaforma (USD): oltre, niente nuove generazioni né
# scontorni (le foto si salvano comunque, senza ritaglio).
AI_MONTHLY_BUDGET_USD=50
# Motore dei job AI (ADR-037): inline = ciclo nel processo del server (locale, container);
# serverless = funzione avviata a richiesta (Vercel). Vuoto: serverless su Vercel, altrimenti inline.
AI_WORKER_MODE=
# Job AI in corso al massimo su tutta la piattaforma (1–50, predefinito 8: sotto il limite di
# 10 richieste contemporanee di fal).
AI_MAX_CONCURRENT_JOBS=
# Segreto che protegge l'avvio dei job AI su funzioni e Vercel Cron (almeno 32 caratteri,
# openssl rand -base64 32). Obbligatorio con AI_WORKER_MODE=serverless e un provider AI.
CRON_SECRET=

# --- Archivio immagini (P-02) --------------------------------------------------------
# filesystem (solo in locale) | r2 (Cloudflare R2, obbligatorio con un APP_URL pubblico).
STORAGE_DRIVER=filesystem
# Cartella dell'archivio locale (relativa alla cartella da cui parte l'app).
STORAGE_DIR=.storage
# Cloudflare R2 (solo con STORAGE_DRIVER=r2). Le chiavi sono segreti: solo nell'hosting.
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
