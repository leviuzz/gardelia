{
  "name": "@floral/db",
  "version": "0.1.0",
  "private": true,
  "description": "Schema Prisma, migrazioni con Row-Level Security, client e helper di tenancy, seed demo.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./testing": "./src/testing.ts"
  },
  "scripts": {
    "generate": "prisma generate",
    "migrate:dev": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "reference-data": "tsx scripts/sync-reference-data.ts",
    "flowers:review": "tsx scripts/flower-review.ts",
    "deploy": "prisma migrate deploy && tsx scripts/sync-reference-data.ts",
    "migrate:status": "prisma migrate status",
    "seed": "tsx prisma/seed.ts",
    "typecheck": "tsc -p tsconfig.json",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@floral/domain": "workspace:*",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@types/pg": "8.23.1",
    "better-auth": "1.7.27",
    "dotenv": "18.0.10",
    "prisma": "7.10.1",
    "tsx": "4.23.15"
  }
}
