// =============================================================================
// Floral OS — schema dati (Prisma 7, PostgreSQL)
//
// Convenzioni (vedi docs/ARCHITECTURE.md e docs/DECISIONS.md):
// - ID: UUID v7 (ordinabili nel tempo), tipo nativo `uuid`.
// - Denaro: interi in unità minime (es. centavos) + valuta ISO 4217 su ogni riga monetaria.
// - Ogni entità di proprietà di un merchant ha `tenantId` ed è protetta da una policy
//   di Row-Level Security definita nelle migrazioni SQL (non esprimibile in Prisma).
// - Le relazioni fra entità dello stesso tenant usano FK composite (tenantId, id):
//   il database rifiuta riferimenti incrociati fra tenant diversi.
// - Date/ore in UTC; il fuso orario di visualizzazione vive su Tenant/Location.
// - Nessuna cancellazione fisica di dati commerciali: si archivia (status ARCHIVED).
// =============================================================================

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// -----------------------------------------------------------------------------
// Identità (globale, non tenant-scoped). Tabelle gestite da Better Auth:
// User, Session, Account, Verification, RateLimit. I nomi dei campi seguono
// lo schema atteso da Better Auth 1.7.
// -----------------------------------------------------------------------------

enum PlatformRole {
  NONE
  SUPER_ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

model User {
  id            String       @id @default(uuid(7)) @db.Uuid
  name          String
  email         String       @unique
  emailVerified Boolean      @default(false)
  image         String?
  /// Lingua preferita dell'interfaccia (BCP 47), es. "es-MX".
  locale        String       @default("es-MX")
  /// Ruolo di piattaforma: MAI impostabile dall'utente in fase di registrazione.
  platformRole  PlatformRole @default(NONE)
  status        UserStatus   @default(ACTIVE)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  sessions           Session[]
  accounts           Account[]
  memberships        Membership[] @relation("MembershipUser")
  invitedMemberships Membership[] @relation("MembershipInviter")
  sentInvitations    Invitation[] @relation("InvitationInviter")
}

model Session {
  id        String   @id @default(uuid(7)) @db.Uuid
  token     String   @unique
  userId    String   @db.Uuid
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String    @id @default(uuid(7)) @db.Uuid
  accountId             String
  providerId            String
  userId                String    @db.Uuid
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  /// Hash della password (scrypt, gestito da Better Auth). Mai in chiaro.
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
}

model Verification {
  id         String   @id @default(uuid(7)) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

/// Contatori del rate limiting di Better Auth (storage "database", condiviso fra istanze).
model RateLimit {
  id          String @id @default(uuid(7)) @db.Uuid
  key         String @unique
  count       Int
  lastRequest BigInt
}

// -----------------------------------------------------------------------------
// Tenancy
// -----------------------------------------------------------------------------

enum TenantStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

/// LIVE = fioreria reale; DEMO = dati dimostrativi (nessuna comunicazione reale verso clienti).
enum TenantMode {
  LIVE
  DEMO
}

enum RecordStatus {
  ACTIVE
  ARCHIVED
}

/// Una fioreria (merchant). Radice dell'isolamento dei dati.
model Tenant {
  id                      String       @id @default(uuid(7)) @db.Uuid
  /// Identificativo URL (/app/{slug}); unico a livello di piattaforma.
  slug                    String       @unique
  displayName             String
  legalName               String?
  /// Identificativo fiscale locale (RFC in Messico). Facoltativo; uso fiscale DA VALIDARE.
  taxId                   String?
  /// ISO 3166-1 alpha-2, es. "MX".
  marketCountry           String       @db.Char(2)
  /// ISO 4217, es. "MXN".
  currency                String       @db.Char(3)
  /// IANA, es. "America/Mexico_City".
  timezone                String
  defaultLocale           String       @default("es-MX")
  contactEmail            String?
  contactPhone            String?
  status                  TenantStatus @default(ACTIVE)
  mode                    TenantMode   @default(LIVE)
  onboardingCompletedAt   DateTime?
  /// Giorni di validità predefiniti di un nuovo preventivo.
  quoteValidityDays       Int          @default(7)
  /// Cargo fisso per l'armado di un bouquet del Builder (unità minime); 0 = nessuno.
  builderLaborFeeMinor    Int          @default(0)
  /// Giorni della settimana in cui la fioreria è chiusa (0 = domenica … 6 = sabato), ADR-055.
  deliveryClosedWeekdays  Int[]        @default([])
  /// Costo di consegna proposto nei nuovi ordini a domicilio (unità minime), ADR-055.
  defaultDeliveryFeeMinor Int          @default(0)
  /// Promo delle date speciali (ADR-047): email automatica con sconto, spenta all'inizio.
  occasionPromoEnabled    Boolean      @default(false)
  occasionPromoKind       DiscountKind @default(PERCENT)
  /// Percentuale intera (1–90) o importo in unità minime; null finché non si sceglie.
  occasionPromoValue      Int?
  createdAt               DateTime     @default(now())
  updatedAt               DateTime     @updatedAt

  locations         Location[]
  memberships       Membership[]
  invitations       Invitation[]
  catalogItems      CatalogItem[]
  recipes           BouquetRecipe[]
  recipeLines       BouquetRecipeLine[]
  inventoryItems    InventoryItem[]
  inventoryEntries  InventoryEntry[]
  inventoryMoves    InventoryMovement[]
  suppliers         Supplier[]
  inventoryHolds    InventoryReservation[]
  inventoryHoldRows InventoryReservationLine[]
  customers         Customer[]
  customerAddresses CustomerAddress[]
  customerOccasions CustomerOccasion[]
  quotes            Quote[]
  quoteLines        QuoteLine[]
  orders            Order[]
  deliveryWindows   DeliveryWindow[]
  orderLines        OrderLine[]
  orderPayments     OrderPayment[]
  orderEvents       OrderStatusEvent[]
  counters          TenantCounter[]
  aiJobs            AiJob[]
  auditLogs         AuditLog[]
  subscription      TenantSubscription?
  builderConfigs    BouquetConfiguration[]
  bouquetPhotos     BouquetPhoto[]
  builderLines      BouquetConfigurationLine[]
  aiCreditGrants    AiCreditGrant[]
  catalogPhotos     CatalogItemPhoto[]
  styleReferences   StyleReferencePhoto[]
  promoEmails       OccasionPromoEmail[]
  publicLinks       PublicLink[]
  orderPhotos       OrderPhoto[]
}

/// Sede operativa. Indirizzo strutturato (mai concatenato in una stringa unica).
model Location {
  id               String       @id @default(uuid(7)) @db.Uuid
  tenantId         String       @db.Uuid
  name             String
  isPrimary        Boolean      @default(false)
  /// Via e numero esterno (MX: calle y número exterior).
  addressLine1     String
  /// Interno/appartamento (MX: número interior).
  addressLine2     String?
  /// MX: colonia.
  neighborhood     String?
  /// MX: municipio / alcaldía.
  city             String
  /// MX: estado (codice, es. "AGU").
  region           String
  postalCode       String
  countryCode      String       @db.Char(2)
  phone            String?
  timezone         String
  deliveryRadiusKm Int?
  status           RecordStatus @default(ACTIVE)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, id])
  @@index([tenantId])
}

enum MembershipRole {
  OWNER
  MANAGER
  STAFF
}

enum MembershipStatus {
  ACTIVE
  SUSPENDED
}

/// Appartenenza di un utente a un tenant con un ruolo.
model Membership {
  id            String           @id @default(uuid(7)) @db.Uuid
  tenantId      String           @db.Uuid
  userId        String           @db.Uuid
  role          MembershipRole
  status        MembershipStatus @default(ACTIVE)
  invitedById   String?          @db.Uuid
  deactivatedAt DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  tenant         Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user           User    @relation("MembershipUser", fields: [userId], references: [id], onDelete: Cascade)
  invitedBy      User?   @relation("MembershipInviter", fields: [invitedById], references: [id], onDelete: SetNull)
  /// Ordini da consegnare assegnati a questo membro (repartidor, ADR-058).
  assignedOrders Order[]

  @@unique([tenantId, userId])
  @@unique([tenantId, id])
  @@index([userId])
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

/// Invito a entrare in un tenant. Il token in chiaro esiste solo nell'email: qui se ne salva l'hash.
model Invitation {
  id           String           @id @default(uuid(7)) @db.Uuid
  tenantId     String           @db.Uuid
  /// Email normalizzata (minuscolo). L'invito può essere accettato solo da quell'email.
  email        String
  role         MembershipRole
  tokenHash    String           @unique
  status       InvitationStatus @default(PENDING)
  expiresAt    DateTime
  invitedById  String           @db.Uuid
  acceptedById String?          @db.Uuid
  acceptedAt   DateTime?
  revokedAt    DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invitedBy User   @relation("InvitationInviter", fields: [invitedById], references: [id], onDelete: Cascade)

  @@unique([tenantId, id])
  @@index([tenantId, status])
  @@index([tenantId, email])
}

/// Registro append-only delle modifiche critiche e degli eventi di sicurezza.
/// tenantId NULL = evento di piattaforma (visibile solo agli admin di piattaforma).
model AuditLog {
  id          String   @id @default(uuid(7)) @db.Uuid
  tenantId    String?  @db.Uuid
  /// Nessuna FK: il registro deve sopravvivere alla cancellazione dell'utente.
  actorUserId String?  @db.Uuid
  action      String
  entityType  String
  entityId    String?
  metadata    Json?
  requestId   String?
  ipAddress   String?
  createdAt   DateTime @default(now())

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt(sort: Desc)])
  @@index([entityType, entityId])
}

// -----------------------------------------------------------------------------
// Catalogo
// -----------------------------------------------------------------------------

enum CanonicalCategory {
  CUT_FLOWER
  FOLIAGE
  PLANT
}

/// Tassonomia normalizzata globale (rosa, tulipano, ...). Non appartiene a nessun tenant;
/// gli SKU dei fioristi possono collegarvisi per ricerca, Builder e matching futuro.
model CanonicalFlower {
  id             String            @id @default(uuid(7)) @db.Uuid
  slug           String            @unique
  scientificName String
  category       CanonicalCategory
  /// Nomi localizzati: { "es-MX": "Rosa", "it-IT": "Rosa", "en-US": "Rose" }.
  names          Json
  /// Altri nomi per lingua (ricerca e specie suggerita dal nome): { "es-MX": ["Nube"] }.
  synonyms       Json              @default("{}")
  colors         String[]
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  catalogItems CatalogItem[]
}

enum CatalogItemType {
  CUT_FLOWER
  FOLIAGE
  PLANT
  BOUQUET
  CONTAINER
  PACKAGING
  ACCESSORY
  SERVICE
  SERVICE_ADDON
}

enum SaleUnit {
  STEM
  BUNCH
  PIECE
  SERVICE
}

enum Availability {
  AVAILABLE
  LIMITED
  OUT_OF_STOCK
  ON_REQUEST
}

/// SKU di un singolo fiorista (prezzo, varietà e disponibilità propri).
model CatalogItem {
  id                String          @id @default(uuid(7)) @db.Uuid
  tenantId          String          @db.Uuid
  type              CatalogItemType
  name              String
  description       String?
  /// Codice interno facoltativo, unico per tenant.
  sku               String?
  canonicalFlowerId String?         @db.Uuid
  variety           String?
  /// Chiavi colore controllate (vedi @floral/domain CATALOG_COLORS).
  colors            String[]
  saleUnit          SaleUnit
  /// Prezzo di vendita per unità di vendita, in unità minime.
  priceMinor        Int
  /// Costo stimato per unità di vendita, in unità minime. NULL = non compilato.
  costMinor         Int?
  currency          String          @db.Char(3)
  availability      Availability    @default(AVAILABLE)
  prepMinutes       Int?
  heightCm          Int?
  widthCm           Int?
  tags              String[]
  /// Utilizzabile come componente nel Bouquet Builder [AI-BQ-01].
  isBuilderEnabled  Boolean         @default(false)
  status            RecordStatus    @default(ACTIVE)
  archivedAt        DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  tenant          Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  canonicalFlower CanonicalFlower?           @relation(fields: [canonicalFlowerId], references: [id], onDelete: SetNull)
  recipe          BouquetRecipe?
  usedInRecipes   BouquetRecipeLine[]        @relation("RecipeIngredient")
  quoteLines      QuoteLine[]
  orderLines      OrderLine[]
  builderLines    BouquetConfigurationLine[]
  photos          CatalogItemPhoto[]
  inventoryItem   InventoryItem?

  @@unique([tenantId, id])
  @@unique([tenantId, sku])
  @@index([tenantId, status, type])
}

enum SubstitutionPolicy {
  /// Chiedere conferma al cliente prima di sostituire un ingrediente.
  ASK_CUSTOMER
  /// Sostituzione consentita con ingrediente simile (stesso colore/categoria).
  SIMILAR_ALLOWED
  /// Nessuna sostituzione: se manca un ingrediente il bouquet non è producibile.
  NOT_ALLOWED
}

/// Distinta base (BOM) di un bouquet. È la fonte di verità per composizione e costi,
/// mai l'immagine generata dall'AI.
model BouquetRecipe {
  id                 String             @id @default(uuid(7)) @db.Uuid
  tenantId           String             @db.Uuid
  /// CatalogItem di tipo BOUQUET (relazione 1:1).
  catalogItemId      String             @db.Uuid
  /// Costo stimato della manodopera, in unità minime. NULL = non compilato.
  laborCostMinor     Int?
  styleTags          String[]
  notes              String?
  substitutionPolicy SubstitutionPolicy @default(ASK_CUSTOMER)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  tenant      Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  catalogItem CatalogItem         @relation(fields: [tenantId, catalogItemId], references: [tenantId, id], onDelete: Cascade)
  lines       BouquetRecipeLine[]

  @@unique([tenantId, id])
  @@unique([tenantId, catalogItemId])
}

model BouquetRecipeLine {
  id               String   @id @default(uuid(7)) @db.Uuid
  tenantId         String   @db.Uuid
  recipeId         String   @db.Uuid
  ingredientItemId String   @db.Uuid
  /// Quantità intera positiva nell'unità di vendita dell'ingrediente (CHECK > 0 nel DB).
  quantity         Int
  sortOrder        Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  tenant     Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  recipe     BouquetRecipe @relation(fields: [tenantId, recipeId], references: [tenantId, id], onDelete: Cascade)
  ingredient CatalogItem   @relation("RecipeIngredient", fields: [tenantId, ingredientItemId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, recipeId, ingredientItemId])
  @@index([tenantId, ingredientItemId])
}

// -----------------------------------------------------------------------------
// Inventario [INV-01] (ADR-060): giacenze dei prodotti del catalogo e registri di magazzino
// -----------------------------------------------------------------------------

/// Tipo di registro di magazzino. Il segno delle quantità dipende dal tipo (CHECK nel DB).
enum InventoryEntryKind {
  /// Existencia inicial, quando si comincia a controllare un prodotto.
  OPENING
  /// Compra al mayorista.
  PURCHASE
  /// Uso: merce usata per un ramo o venduta.
  USE
  /// Merma: merce buttata (appassita, rovinata).
  WASTE
  /// Ajuste: la differenza trovata con un conteggio fisico.
  ADJUSTMENT
  /// Anulación di un registro sbagliato: movimenti opposti, mai una cancellazione.
  REVERSAL
}

/// Prodotto del catalogo di cui la fioreria controlla la giacenza (uno per prodotto).
/// La giacenza cambia solo insieme a un movimento, nella stessa transazione.
model InventoryItem {
  id               String       @id @default(uuid(7)) @db.Uuid
  tenantId         String       @db.Uuid
  catalogItemId    String       @db.Uuid
  /// Giacenza nell'unità di vendita del prodotto; sotto zero solo con conferma.
  onHand           Int          @default(0)
  /// Costo reale medio per unità (media ponderata degli ingressi), unità minime. NULL = non noto.
  avgUnitCostMinor Int?
  currency         String       @db.Char(3)
  /// "Avísame cuando queden": avviso quando il disponibile scende a questo numero. NULL = nessuno.
  minQuantity      Int?
  /// ARCHIVED = la fioreria non lo controlla più (lo storico resta).
  status           RecordStatus @default(ACTIVE)
  archivedAt       DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  tenant      Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  catalogItem CatalogItem                @relation(fields: [tenantId, catalogItemId], references: [tenantId, id], onDelete: Restrict)
  movements   InventoryMovement[]
  holds       InventoryReservationLine[]

  @@unique([tenantId, id])
  @@unique([tenantId, catalogItemId])
  @@index([tenantId, status])
}

/// Registro di magazzino: un'operazione con una o più righe. Solo lettura e inserimento (RLS):
/// uno sbaglio si annulla con un registro REVERSAL.
model InventoryEntry {
  id              String             @id @default(uuid(7)) @db.Uuid
  tenantId        String             @db.Uuid
  kind            InventoryEntryKind
  note            String?
  /// Solo per REVERSAL: il registro annullato (una sola anulación per registro).
  reversesEntryId String?            @db.Uuid
  /// Solo per PURCHASE: proveedor (facoltativo), factura o nota, giorno della compra.
  supplierId      String?            @db.Uuid
  reference       String?
  purchasedOn     DateTime?          @db.Date
  createdById     String?            @db.Uuid
  /// Quando è successo (es. il giorno della compra); di solito coincide con createdAt.
  occurredAt      DateTime           @default(now())
  createdAt       DateTime           @default(now())

  tenant      Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  supplier    Supplier?             @relation(fields: [tenantId, supplierId], references: [tenantId, id], onDelete: Restrict)
  reverses    InventoryEntry?       @relation("InventoryReversal", fields: [tenantId, reversesEntryId], references: [tenantId, id], onDelete: Restrict)
  reversedBy  InventoryEntry?       @relation("InventoryReversal")
  movements   InventoryMovement[]
  /// L'apartado usato con questo registro (ADR-062).
  reservation InventoryReservation?

  @@unique([tenantId, id])
  /// Bersaglio della FK dei movimenti: il tipo del movimento è sempre quello del registro.
  @@unique([tenantId, id, kind])
  @@unique([tenantId, reversesEntryId])
  @@index([tenantId, occurredAt])
}

enum InventoryReservationStatus {
  /// Tiene la merce fino alla fine del giorno di scadenza (poi è vencido, senza job).
  ACTIVE
  /// Usato: la merce è uscita con un registro di uso.
  USED
  /// Liberato a mano: la merce torna disponibile.
  RELEASED
}

/// Apartado (ADR-062): merce messa da parte per un evento o un cliente fino a una data. Non cambia
/// la giacenza: toglie merce dal disponibile finché vale.
model InventoryReservation {
  id          String                     @id @default(uuid(7)) @db.Uuid
  tenantId    String                     @db.Uuid
  /// "Para": l'evento o il cliente ("Boda de Ana").
  label       String
  note        String?
  /// Ultimo giorno in cui vale, nel calendario della fioreria.
  expiresOn   DateTime                   @db.Date
  status      InventoryReservationStatus @default(ACTIVE)
  /// Solo per USED: il registro di uso (nessuno se non restava nulla da registrare).
  usedEntryId String?                    @db.Uuid
  closedAt    DateTime?
  closedById  String?                    @db.Uuid
  createdById String?                    @db.Uuid
  createdAt   DateTime                   @default(now())
  updatedAt   DateTime                   @updatedAt

  tenant    Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  usedEntry InventoryEntry?            @relation(fields: [tenantId, usedEntryId], references: [tenantId, id], onDelete: Restrict)
  lines     InventoryReservationLine[]

  @@unique([tenantId, id])
  @@unique([tenantId, usedEntryId])
  @@index([tenantId, status, expiresOn])
}

/// Riga di un apartado: un prodotto controllato e quanto se ne mette da parte.
model InventoryReservationLine {
  id              String   @id @default(uuid(7)) @db.Uuid
  tenantId        String   @db.Uuid
  reservationId   String   @db.Uuid
  inventoryItemId String   @db.Uuid
  quantity        Int
  /// Quanto si è usato davvero quando l'apartado è stato usato (NULL prima).
  usedQuantity    Int?
  createdAt       DateTime @default(now())

  tenant      Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  reservation InventoryReservation @relation(fields: [tenantId, reservationId], references: [tenantId, id], onDelete: Restrict)
  item        InventoryItem        @relation(fields: [tenantId, inventoryItemId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@unique([reservationId, inventoryItemId])
  @@index([tenantId, inventoryItemId])
}

/// Proveedor della fioreria (mayorista, mercado) per le compras (ADR-061). Si archivia, non si cancella.
model Supplier {
  id         String       @id @default(uuid(7)) @db.Uuid
  tenantId   String       @db.Uuid
  name       String
  phone      String?
  notes      String?
  status     RecordStatus @default(ACTIVE)
  archivedAt DateTime?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  tenant    Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  purchases InventoryEntry[]

  @@unique([tenantId, id])
  @@index([tenantId, status, name])
}

/// Riga di un registro: di quanto cambia la giacenza di un prodotto e a che costo.
model InventoryMovement {
  id                    String             @id @default(uuid(7)) @db.Uuid
  tenantId              String             @db.Uuid
  entryId               String             @db.Uuid
  /// Uguale al tipo del registro (FK composita): permette il CHECK sul segno.
  kind                  InventoryEntryKind
  inventoryItemId       String             @db.Uuid
  /// Variazione della giacenza, con segno, nell'unità di vendita del prodotto.
  quantity              Int
  /// Giacenza del prodotto subito dopo questo movimento.
  balanceAfter          Int
  /// Costo reale per unità: prezzo della compra o costo medio al momento. NULL = non noto.
  unitCostMinor         Int?
  /// Costo del catalogo al momento (costo previsto). NULL = non compilato.
  expectedUnitCostMinor Int?
  /// Solo per PURCHASE: totale pagato per la riga (il costo per unità è arrotondato).
  totalCostMinor        Int?
  currency              String             @db.Char(3)
  createdAt             DateTime           @default(now())

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  entry         InventoryEntry @relation(fields: [tenantId, entryId, kind], references: [tenantId, id, kind], onDelete: Restrict)
  inventoryItem InventoryItem  @relation(fields: [tenantId, inventoryItemId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@unique([tenantId, entryId, inventoryItemId])
  @@index([tenantId, inventoryItemId, createdAt])
}

// -----------------------------------------------------------------------------
// CRM (confine dati Sprint 0; funzionalità complete nello Sprint 1)
// -----------------------------------------------------------------------------

enum CustomerType {
  PERSON
  COMPANY
}

/// Origine del cliente/ordine: determina l'attribuzione delle commissioni future.
/// MERCHANT_DIRECT, IMPORT e MANUAL non generano MAI fee marketplace.
enum AcquisitionSource {
  MERCHANT_DIRECT
  NETWORK_B2B
  MARKETPLACE_B2C
  IMPORT
  MANUAL
}

model Customer {
  id                 String            @id @default(uuid(7)) @db.Uuid
  tenantId           String            @db.Uuid
  type               CustomerType      @default(PERSON)
  displayName        String
  legalName          String?
  taxId              String?
  email              String?
  /// Formato E.164, es. "+524491234567".
  phone              String?
  notes              String?
  /// Preferenze floreali (testo libero del fiorista).
  preferences        String?
  /// Restrizioni note (allergie, fiori da evitare).
  restrictions       String?
  tags               String[]
  acquisitionSource  AcquisitionSource @default(MERCHANT_DIRECT)
  acquisitionChannel String?
  marketingConsent   Boolean           @default(false)
  marketingConsentAt DateTime?
  status             RecordStatus      @default(ACTIVE)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  tenant      Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  quotes      Quote[]
  orders      Order[]
  addresses   CustomerAddress[]
  occasions   CustomerOccasion[]
  promoEmails OccasionPromoEmail[]

  @@unique([tenantId, id])
  @@index([tenantId, status])
}

/// Indirizzo di consegna di un cliente (anche di un destinatario regalo).
/// Il destinatario NON diventa un contatto marketing (spec §5.2).
model CustomerAddress {
  id             String       @id @default(uuid(7)) @db.Uuid
  tenantId       String       @db.Uuid
  customerId     String       @db.Uuid
  /// Etichetta libera: "Casa", "Oficina", "Mamá".
  label          String?
  recipientName  String?
  /// Formato E.164.
  recipientPhone String?
  addressLine1   String
  addressLine2   String?
  neighborhood   String?
  city           String
  region         String
  postalCode     String
  countryCode    String       @db.Char(2)
  /// Referencias / entre calles / istruzioni per il corriere.
  deliveryNotes  String?
  isDefault      Boolean      @default(false)
  status         RecordStatus @default(ACTIVE)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [tenantId, customerId], references: [tenantId, id], onDelete: Cascade)
  orders   Order[]

  @@unique([tenantId, id])
  @@index([tenantId, customerId])
}

enum OccasionType {
  BIRTHDAY
  ANNIVERSARY
  CUSTOM
}

/// Ricorrenza da ricordare (compleanno, anniversario, data personalizzata).
/// `personName` valorizzato = ricorrenza di un destinatario, non del cliente stesso.
model CustomerOccasion {
  id               String       @id @default(uuid(7)) @db.Uuid
  tenantId         String       @db.Uuid
  customerId       String       @db.Uuid
  type             OccasionType
  /// Obbligatoria per CUSTOM (es. "Día de las madres").
  label            String?
  personName       String?
  month            Int
  day              Int
  /// Anno facoltativo (es. anno di nascita o del matrimonio).
  year             Int?
  remindDaysBefore Int          @default(7)
  notes            String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  tenant      Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer    Customer             @relation(fields: [tenantId, customerId], references: [tenantId, id], onDelete: Cascade)
  promoEmails OccasionPromoEmail[]

  @@unique([tenantId, id])
  @@index([tenantId, month, day])
  @@index([tenantId, customerId])
}

/// Sconto della promo: percentuale intera o importo fisso in unità minime.
enum DiscountKind {
  PERCENT
  AMOUNT
}

enum PromoEmailStatus {
  /// Presa in carico, invio in corso.
  SENDING
  SENT
  /// Non partita: si riprova nei giorni seguenti, fino a 3 tentativi, se la data non è passata.
  FAILED
}

/// Email della promo per una ricorrenza di una data speciale (ADR-047): al massimo una per data e
/// anno. Conserva lo sconto promesso anche se la fioreria lo cambia dopo. Nessun indirizzo email.
model OccasionPromoEmail {
  id             String           @id @default(uuid(7)) @db.Uuid
  tenantId       String           @db.Uuid
  occasionId     String           @db.Uuid
  customerId     String           @db.Uuid
  /// Giorno della ricorrenza (fino a cui vale lo sconto).
  occurrenceDate DateTime         @db.Date
  status         PromoEmailStatus @default(SENDING)
  attempts       Int              @default(1)
  discountKind   DiscountKind
  discountValue  Int
  currency       String           @db.Char(3)
  sentAt         DateTime?
  /// Motivo dell'ultimo fallimento (codice, es. `send_failed`), mai testo del provider.
  lastError      String?
  /// Codice personale dello sconto (6 caratteri, senza trattino), unico nella fioreria (ADR-048).
  code           String
  /// Sconto usato: quando, chi della fioreria l'ha segnato e una nota facoltativa.
  redeemedAt     DateTime?
  /// Nessuna FK, come negli altri riferimenti a chi ha agito: il dato resta anche senza l'utente.
  redeemedById   String?          @db.Uuid
  redemptionNote String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  tenant   Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  occasion CustomerOccasion @relation(fields: [tenantId, occasionId], references: [tenantId, id], onDelete: Cascade)
  customer Customer         @relation(fields: [tenantId, customerId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, id])
  @@unique([tenantId, occasionId, occurrenceDate])
  @@unique([tenantId, code])
  @@index([tenantId, occurrenceDate])
  @@index([tenantId, customerId])
}

// -----------------------------------------------------------------------------
// Preventivi (confine dati Sprint 0; flusso completo nello Sprint 1)
// -----------------------------------------------------------------------------

enum QuoteTaxMode {
  /// Prezzi finali al cliente, nessun calcolo d'imposta (finché O-06 non è validata).
  PRICES_FINAL
}

enum QuoteLineKind {
  /// Articolo del catalogo (prezzo e distinta presi dal listino al momento dell'aggiunta).
  CATALOG_ITEM
  /// Riga libera con prezzo indicato dal fiorista (es. consegna, allestimento speciale).
  CUSTOM
  /// Bouquet composto nel Builder: prezzo e distinta esatta calcolati sul server.
  BUILDER
}

/// Contatori progressivi per tenant (numerazione preventivi, ordini…), incrementati
/// atomicamente nella stessa transazione del documento: niente buchi né duplicati.
model TenantCounter {
  tenantId  String   @db.Uuid
  key       String
  value     Int
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@id([tenantId, key])
}

enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
  CANCELLED
}

model Quote {
  id                String            @id @default(uuid(7)) @db.Uuid
  tenantId          String            @db.Uuid
  /// Numero progressivo per tenant, assegnato dal servizio.
  number            Int
  customerId        String            @db.Uuid
  /// Titolo facoltativo (es. "Arreglo para recepción").
  title             String?
  status            QuoteStatus       @default(DRAFT)
  statusChangedAt   DateTime?
  currency          String            @db.Char(3)
  /// Come sono trattate le imposte. PRICES_FINAL = prezzi finali senza scorporo (O-06 aperta).
  taxMode           QuoteTaxMode      @default(PRICES_FINAL)
  subtotalMinor     Int               @default(0)
  discountMinor     Int               @default(0)
  taxMinor          Int               @default(0)
  totalMinor        Int               @default(0)
  /// Data (senza ora) fino a cui il preventivo è valido, nel calendario del tenant.
  validUntil        DateTime?         @db.Date
  notes             String?
  acquisitionSource AcquisitionSource @default(MERCHANT_DIRECT)
  createdById       String?           @db.Uuid
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer    Customer     @relation(fields: [tenantId, customerId], references: [tenantId, id], onDelete: Restrict)
  lines       QuoteLine[]
  order       Order?
  publicLinks PublicLink[]

  @@unique([tenantId, id])
  @@unique([tenantId, number])
  @@index([tenantId, status])
}

model QuoteLine {
  id                     String        @id @default(uuid(7)) @db.Uuid
  tenantId               String        @db.Uuid
  quoteId                String        @db.Uuid
  kind                   QuoteLineKind @default(CATALOG_ITEM)
  /// NULL per righe libere (non a catalogo).
  catalogItemId          String?       @db.Uuid
  /// Solo per righe BUILDER: il disegno da cui è nata la riga.
  bouquetConfigurationId String?       @db.Uuid
  description            String
  quantity               Int
  unitPriceMinor         Int
  /// Snapshot del costo al momento del preventivo (NULL = non compilato).
  unitCostMinor          Int?
  lineTotalMinor         Int
  /// Snapshot dell'articolo (nome, tipo, distinta) al momento del preventivo.
  snapshot               Json?
  /// Solo per righe BUILDER: anteprima AI riuscita del ramo quando la riga è nata (ADR-035).
  previewJobId           String?       @db.Uuid
  /// Solo per righe BUILDER: foto vera del ramo caricata dalla fioreria (ADR-052); se c'è, si
  /// mostra al posto dell'anteprima AI.
  bouquetPhotoId         String?       @db.Uuid
  sortOrder              Int           @default(0)
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt

  tenant               Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  quote                Quote                 @relation(fields: [tenantId, quoteId], references: [tenantId, id], onDelete: Cascade)
  catalogItem          CatalogItem?          @relation(fields: [tenantId, catalogItemId], references: [tenantId, id], onDelete: Restrict)
  bouquetConfiguration BouquetConfiguration? @relation(fields: [tenantId, bouquetConfigurationId], references: [tenantId, id], onDelete: Restrict)
  previewJob           AiJob?                @relation(fields: [tenantId, previewJobId], references: [tenantId, id], onDelete: Restrict)
  bouquetPhoto         BouquetPhoto?         @relation(fields: [tenantId, bouquetPhotoId], references: [tenantId, id], onDelete: Restrict)

  @@index([tenantId, quoteId])
  @@index([tenantId, bouquetConfigurationId])
  @@index([tenantId, previewJobId])
  @@index([tenantId, bouquetPhotoId])
}

// -----------------------------------------------------------------------------
// Job AI (confine dati Sprint 0; pipeline reale nello Sprint 2)
// -----------------------------------------------------------------------------

enum AiFeature {
  BOUQUET_PREVIEW
  ROOM_PREVIEW
  /// Scontorno delle foto del catalogo (ADR-033): costo della piattaforma, non consuma crediti.
  PHOTO_CUTOUT
}

enum AiJobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}

model AiJob {
  id                     String         @id @default(uuid(7)) @db.Uuid
  tenantId               String         @db.Uuid
  feature                AiFeature
  status                 AiJobStatus    @default(QUEUED)
  requestedById          String         @db.Uuid
  /// Disegno del Builder per cui è stata richiesta l'anteprima (il primo richiedente).
  bouquetConfigurationId String?        @db.Uuid
  /// Da dove è stato scalato il credito (quota del mese o extra); null = non consuma.
  quotaSource            AiQuotaSource?
  /// Hash della configurazione normalizzata (caching delle preview identiche, per tenant).
  inputHash              String
  input                  Json
  output                 Json?
  provider               String?
  model                  String?
  promptVersion          String?
  attempts               Int            @default(0)
  maxAttempts            Int            @default(3)
  errorCode              String?
  errorMessage           String?
  /// Crediti consumati secondo la policy di quota (0 finché il job non riesce).
  usageUnits             Int            @default(0)
  /// Costo stimato all'accodamento (micro-USD), per il tetto di spesa della piattaforma.
  estimatedCostMicros    Int            @default(0)
  /// Coda (ADR-025): prossimo tentativo e scadenza del lease del worker.
  runAfter               DateTime       @default(now())
  lockedUntil            DateTime?
  /// Immagine prodotta nell'archivio (chiave `tenants/{tenantId}/…`).
  outputKey              String?
  outputContentType      String?
  /// Costo del provider per la piattaforma, in micro-unità della valuta indicata.
  providerCostMicros     Int?
  providerCurrency       String?        @db.Char(3)
  startedAt              DateTime?
  finishedAt             DateTime?
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt

  tenant               Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  bouquetConfiguration BouquetConfiguration? @relation(fields: [tenantId, bouquetConfigurationId], references: [tenantId, id], onDelete: Restrict)
  quoteLines           QuoteLine[]
  orderLines           OrderLine[]

  @@unique([tenantId, id])
  @@index([tenantId, feature, createdAt])
  @@index([tenantId, inputHash])
  @@index([status, runAfter])
}

enum AiQuotaSource {
  INCLUDED
  EXTRA
}

/// Crediti AI extra (pacchetti pagati alla piattaforma) sbloccati dalla CLI di piattaforma
/// (ADR-024). Il tenant li legge, non li scrive. Non scadono.
model AiCreditGrant {
  id          String    @id @default(uuid(7)) @db.Uuid
  tenantId    String    @db.Uuid
  feature     AiFeature
  units       Int
  /// Riferimento interno (es. pagamento ricevuto): mai dati personali.
  note        String?
  grantedById String    @db.Uuid
  createdAt   DateTime  @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, feature, createdAt])
}

// -----------------------------------------------------------------------------
// Piani SaaS e abbonamenti [BILL-01]. Nessun prezzo (D-16 PROPOSTO) né pagamento:
// nel pilota l'abbonamento è assegnato manualmente da un admin di piattaforma (C-03).
// -----------------------------------------------------------------------------

enum PlanCode {
  BASIC
  PLUS
}

enum SubscriptionStatus {
  PILOT
  TRIALING
  ACTIVE
  CANCELLED
}

enum SubscriptionSource {
  /// Assegnato da un admin di piattaforma (CLI `pnpm platform:assign-plan`).
  MANUAL
}

/// Dati di piattaforma (non del merchant): leggibili da tutti, scrivibili solo in contesto
/// di sistema. I piani BASIC e PLUS sono creati dalla migrazione.
model SaasPlan {
  id           String   @id @default(uuid(7)) @db.Uuid
  code         PlanCode @unique
  /// Validati da `planEntitlementsSchema` (@floral/domain); malformati = nessun accesso.
  entitlements Json
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  subscriptions TenantSubscription[]
}

/// Abbonamento corrente della fioreria: il merchant lo legge, solo la piattaforma lo scrive.
/// Senza abbonamento valido si applica il piano predefinito (BASIC).
model TenantSubscription {
  id                 String             @id @default(uuid(7)) @db.Uuid
  tenantId           String             @unique @db.Uuid
  planId             String             @db.Uuid
  status             SubscriptionStatus
  source             SubscriptionSource @default(MANUAL)
  currentPeriodStart DateTime           @default(now())
  /// null = senza scadenza (es. pilota a tempo indeterminato).
  currentPeriodEnd   DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  tenant Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan   SaasPlan @relation(fields: [planId], references: [id], onDelete: Restrict)

  @@index([planId])
}

// -----------------------------------------------------------------------------
// Bouquet Builder deterministico [AI-BQ-01…04, 06]. Il prezzo lo calcola il server con
// `priceBouquet` (@floral/domain); i prezzi salvati sono uno snapshot "al salvataggio".
// -----------------------------------------------------------------------------

enum BouquetStyle {
  ROMANTIC
  CLASSIC
  MODERN
  GARDEN
  MINIMAL
  TROPICAL
}

enum BouquetSize {
  SMALL
  MEDIUM
  LARGE
  EXTRA_LARGE
}

enum BuilderRole {
  FLOWER
  FOLIAGE
  PACKAGING
  ACCESSORY
}

model BouquetConfiguration {
  id                 String        @id @default(uuid(7)) @db.Uuid
  tenantId           String        @db.Uuid
  name               String
  style              BouquetStyle?
  size               BouquetSize?
  /// Budget indicato dal cliente (orientativo, non cambia il prezzo).
  budgetMinor        Int?
  notes              String?
  currency           String        @db.Char(3)
  componentsMinor    Int
  laborMinor         Int
  totalMinor         Int
  /// Costo materiali al salvataggio; NULL se manca un costo.
  estimatedCostMinor Int?
  pricingVersion     String
  status             RecordStatus  @default(ACTIVE)
  archivedAt         DateTime?
  createdById        String        @db.Uuid
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  tenant     Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lines      BouquetConfigurationLine[]
  quoteLines QuoteLine[]
  orderLines OrderLine[]
  aiJobs     AiJob[]
  photos     BouquetPhoto[]

  @@unique([tenantId, id])
  @@index([tenantId, status, updatedAt])
}

/// Foto vera di un ramo del Diseñador, caricata dalla fioreria invece di generarla (ADR-052).
/// Una sola ATTIVA per disegno (indice parziale nel SQL); cambiandola, la precedente si archivia
/// e resta ai preventivi che la mostrano.
model BouquetPhoto {
  id              String       @id @default(uuid(7)) @db.Uuid
  tenantId        String       @db.Uuid
  configurationId String       @db.Uuid
  storageKey      String
  thumbKey        String
  contentType     String
  width           Int
  height          Int
  sizeBytes       Int
  status          RecordStatus @default(ACTIVE)
  archivedAt      DateTime?
  createdById     String       @db.Uuid
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  tenant        Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  configuration BouquetConfiguration @relation(fields: [tenantId, configurationId], references: [tenantId, id], onDelete: Cascade)
  quoteLines    QuoteLine[]
  orderLines    OrderLine[]

  @@unique([tenantId, id])
  @@index([tenantId, configurationId, status])
}

model BouquetConfigurationLine {
  id              String      @id @default(uuid(7)) @db.Uuid
  tenantId        String      @db.Uuid
  configurationId String      @db.Uuid
  catalogItemId   String      @db.Uuid
  role            BuilderRole
  quantity        Int
  /// Colore scelto per carta, vaso o nastro (uno dei colori dell'articolo); null per fiori
  /// e follaje o articoli senza colori (ADR-030).
  color           String?
  /// Prezzo e costo unitari al salvataggio (snapshot).
  unitPriceMinor  Int
  unitCostMinor   Int?
  lineTotalMinor  Int
  sortOrder       Int         @default(0)
  createdAt       DateTime    @default(now())

  tenant        Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  configuration BouquetConfiguration @relation(fields: [tenantId, configurationId], references: [tenantId, id], onDelete: Cascade)
  catalogItem   CatalogItem          @relation(fields: [tenantId, catalogItemId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@unique([tenantId, configurationId, catalogItemId])
  @@index([tenantId, catalogItemId])
}

// -----------------------------------------------------------------------------
// Foto del catalogo e "Mis ramos" (ADR-029)
// -----------------------------------------------------------------------------

enum CatalogPhotoView {
  FRONT
  SIDE
  TOP
  DETAIL
}

/// Scontorno automatico di una foto del catalogo (ADR-033).
enum CutoutStatus {
  PENDING
  READY
  FAILED
}

/// Foto di un articolo del catalogo (fiori da più angolazioni; carte e nastri per colore).
/// I file stanno nell'archivio (R2) sotto `tenants/{tenantId}/catalog-photos/`, mai pubblici.
model CatalogItemPhoto {
  id            String           @id @default(uuid(7)) @db.Uuid
  tenantId      String           @db.Uuid
  catalogItemId String           @db.Uuid
  view          CatalogPhotoView @default(FRONT)
  /// Uno dei colori dell'articolo (CATALOG_COLORS), o null se la foto non è per un colore.
  color         String?
  storageKey    String
  thumbKey      String
  contentType   String
  width         Int
  height        Int
  sizeBytes     Int
  sortOrder     Int              @default(0)
  /// Versione senza fondo (PNG trasparente) per la composizione del ramo; null se non chiesta.
  cutoutStatus  CutoutStatus?
  cutoutKey     String?
  /// Motivo di un fallimento (codice, es. `cutout_nothing_kept`), mai testo dell'utente.
  cutoutError   String?
  status        RecordStatus     @default(ACTIVE)
  archivedAt    DateTime?
  createdById   String           @db.Uuid
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  catalogItem CatalogItem @relation(fields: [tenantId, catalogItemId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, id])
  @@index([tenantId, catalogItemId, status, sortOrder])
}

/// Foto di un ramo fatto dalla fioreria ("Mis ramos"): riferimento di stile per le anteprime
/// AI, caricata solo con consenso esplicito (chi e quando). Mai usata per addestrare modelli.
model StyleReferencePhoto {
  id                  String        @id @default(uuid(7)) @db.Uuid
  tenantId            String        @db.Uuid
  style               BouquetStyle?
  caption             String?
  storageKey          String
  thumbKey            String
  contentType         String
  width               Int
  height              Int
  sizeBytes           Int
  consentAt           DateTime
  consentById         String        @db.Uuid
  /// Stile fotografico descritto a parole da un modello di visione (inglese, per il prompt) e
  /// in spagnolo per il fiorista; generato una volta alla prima anteprima che lo usa (ADR-032).
  styleDescription    String?
  styleDescriptionEs  String?
  styleDescribedAt    DateTime?
  styleDescriberModel String?
  status              RecordStatus  @default(ACTIVE)
  archivedAt          DateTime?
  createdById         String        @db.Uuid
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, id])
  @@index([tenantId, status, createdAt])
}

// =============================================================================
// Ordini, pagamenti registrati e consegne [ORD-01] (ADR-054, docs/ORDERS_MARKETPLACE_PLAN.md)
// =============================================================================

enum OrderStatus {
  /// Ordine diretto in composizione: righe, consegna e tarjeta prima della conferma (A1b).
  DRAFT
  /// Ordine del marketplace in attesa che la fioreria lo accetti (D-26; arriva con il blocco C4).
  PENDING_ACCEPTANCE
  CONFIRMED
  IN_PREPARATION
  READY
  OUT_FOR_DELIVERY
  DELIVERED
  PICKED_UP
  CANCELLED
}

enum FulfillmentMode {
  DELIVERY
  PICKUP
}

enum OrderPaymentStatus {
  UNPAID
  PARTIAL
  PAID
}

/// Pagamento ricevuto dalla fioreria e registrato a mano (D-26: nessun pagamento online nella V1).
enum PaymentMethod {
  CASH
  TRANSFER
  CARD_TERMINAL
  PAYMENT_LINK
  OTHER
}

enum OrderPaymentKind {
  DEPOSIT
  BALANCE
  /// Storno di un pagamento registrato per errore: importo negativo, nessuna cancellazione.
  REVERSAL
}

model Order {
  id                   String             @id @default(uuid(7)) @db.Uuid
  tenantId             String             @db.Uuid
  /// Numero progressivo per tenant (PED-0001), assegnato dal servizio.
  number               Int
  customerId           String             @db.Uuid
  /// Preventivo da cui è nato l'ordine (al massimo un ordine per preventivo).
  quoteId              String?            @db.Uuid
  status               OrderStatus        @default(CONFIRMED)
  statusChangedAt      DateTime           @default(now())
  currency             String             @db.Char(3)
  fulfillmentMode      FulfillmentMode
  /// Giorno di consegna o ritiro, nel calendario del tenant (NULL solo per i borradores).
  scheduledDate        DateTime?          @db.Date
  /// Fascia oraria in minuti dalla mezzanotte (fuso del tenant); entrambi NULL = in giornata.
  windowStartMinutes   Int?
  windowEndMinutes     Int?
  /// Indirizzo del cliente da cui è stato copiato quello di consegna (facoltativo).
  customerAddressId    String?            @db.Uuid
  /// Indirizzo di consegna COPIATO nell'ordine: cambiare la rubrica non cambia gli ordini.
  deliveryAddressLine1 String?
  deliveryAddressLine2 String?
  deliveryNeighborhood String?
  deliveryCity         String?
  deliveryRegion       String?
  deliveryPostalCode   String?
  deliveryCountryCode  String?            @db.Char(2)
  /// Referencias / entre calles / istruzioni per chi consegna ("llamar antes", "es sorpresa").
  deliveryNotes        String?
  recipientName        String?
  /// Formato E.164.
  recipientPhone       String?
  /// Tarjeta: messaggio per chi riceve il ramo.
  cardMessage          String?
  cardSignature        String?
  cardAnonymous        Boolean            @default(false)
  /// Note interne della fioreria.
  notes                String?
  subtotalMinor        Int
  discountMinor        Int                @default(0)
  deliveryFeeMinor     Int                @default(0)
  taxMinor             Int                @default(0)
  totalMinor           Int
  /// Somma dei pagamenti registrati (storni compresi), mantenuta dal servizio.
  paidMinor            Int                @default(0)
  paymentStatus        OrderPaymentStatus @default(UNPAID)
  acquisitionSource    AcquisitionSource  @default(MERCHANT_DIRECT)
  cancelReason         String?
  /// Chi porta l'ordine (repartidor): un membro della fioreria, ADR-058.
  assignedMembershipId String?            @db.Uuid
  /// Chi ha ricevuto il ramo alla consegna o al ritiro (prova di consegna, ADR-058).
  handoverName         String?
  createdById          String?            @db.Uuid
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  tenant          Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer        Customer           @relation(fields: [tenantId, customerId], references: [tenantId, id], onDelete: Restrict)
  quote           Quote?             @relation(fields: [tenantId, quoteId], references: [tenantId, id], onDelete: Restrict)
  assignedTo      Membership?        @relation(fields: [tenantId, assignedMembershipId], references: [tenantId, id], onDelete: Restrict)
  customerAddress CustomerAddress?   @relation(fields: [tenantId, customerAddressId], references: [tenantId, id], onDelete: Restrict)
  lines           OrderLine[]
  payments        OrderPayment[]
  events          OrderStatusEvent[]
  publicLinks     PublicLink[]
  photos          OrderPhoto[]

  @@unique([tenantId, id])
  @@unique([tenantId, number])
  @@unique([tenantId, quoteId])
  @@index([tenantId, status])
  @@index([tenantId, scheduledDate])
  @@index([tenantId, customerId])
  @@index([tenantId, assignedMembershipId])
}

/// Righe dell'ordine: stesse regole e snapshot delle righe del preventivo (`QuoteLineKind`).
model OrderLine {
  id                     String        @id @default(uuid(7)) @db.Uuid
  tenantId               String        @db.Uuid
  orderId                String        @db.Uuid
  kind                   QuoteLineKind @default(CATALOG_ITEM)
  catalogItemId          String?       @db.Uuid
  bouquetConfigurationId String?       @db.Uuid
  description            String
  quantity               Int
  unitPriceMinor         Int
  unitCostMinor          Int?
  lineTotalMinor         Int
  snapshot               Json?
  previewJobId           String?       @db.Uuid
  /// Foto vera del ramo (ADR-052), copiata dalla riga del preventivo: ha la precedenza sull'AI.
  bouquetPhotoId         String?       @db.Uuid
  sortOrder              Int           @default(0)
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt

  tenant               Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order                Order                 @relation(fields: [tenantId, orderId], references: [tenantId, id], onDelete: Cascade)
  catalogItem          CatalogItem?          @relation(fields: [tenantId, catalogItemId], references: [tenantId, id], onDelete: Restrict)
  bouquetConfiguration BouquetConfiguration? @relation(fields: [tenantId, bouquetConfigurationId], references: [tenantId, id], onDelete: Restrict)
  previewJob           AiJob?                @relation(fields: [tenantId, previewJobId], references: [tenantId, id], onDelete: Restrict)
  bouquetPhoto         BouquetPhoto?         @relation(fields: [tenantId, bouquetPhotoId], references: [tenantId, id], onDelete: Restrict)

  @@index([tenantId, orderId])
  @@index([tenantId, bouquetConfigurationId])
  @@index([tenantId, previewJobId])
  @@index([tenantId, bouquetPhotoId])
}

model OrderPayment {
  id                String           @id @default(uuid(7)) @db.Uuid
  tenantId          String           @db.Uuid
  orderId           String           @db.Uuid
  kind              OrderPaymentKind
  method            PaymentMethod
  /// Positivo per acconti e saldi, negativo per gli storni.
  amountMinor       Int
  /// Giorno del pagamento, nel calendario del tenant.
  paidOn            DateTime         @db.Date
  reference         String?
  /// Solo per gli storni: il pagamento stornato (uno storno per pagamento).
  reversedPaymentId String?          @db.Uuid
  createdById       String?          @db.Uuid
  createdAt         DateTime         @default(now())

  tenant          Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order           Order         @relation(fields: [tenantId, orderId], references: [tenantId, id], onDelete: Cascade)
  reversedPayment OrderPayment? @relation("PaymentReversal", fields: [tenantId, reversedPaymentId], references: [tenantId, id], onDelete: Restrict)
  reversal        OrderPayment? @relation("PaymentReversal")

  @@unique([tenantId, id])
  @@unique([tenantId, reversedPaymentId])
  @@index([tenantId, orderId])
}

/// Cronologia degli stati dell'ordine (chi, quando, da dove a dove).
model OrderStatusEvent {
  id          String       @id @default(uuid(7)) @db.Uuid
  tenantId    String       @db.Uuid
  orderId     String       @db.Uuid
  /// NULL per l'evento di creazione.
  fromStatus  OrderStatus?
  toStatus    OrderStatus
  note        String?
  createdById String?      @db.Uuid
  createdAt   DateTime     @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order  Order  @relation(fields: [tenantId, orderId], references: [tenantId, id], onDelete: Cascade)

  @@index([tenantId, orderId, createdAt])
}

/// Fascia oraria di consegna o ritiro proposta nei form degli ordini (ADR-055). Configurazione,
/// non dato commerciale: ogni ordine copia i propri minuti, quindi togliere una fascia non cambia
/// gli ordini già fatti.
model DeliveryWindow {
  id           String   @id @default(uuid(7)) @db.Uuid
  tenantId     String   @db.Uuid
  /// Minuti dalla mezzanotte nel fuso della fioreria.
  startMinutes Int
  endMinutes   Int
  createdAt    DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, id])
  @@unique([tenantId, startMinutes, endMinutes])
  @@index([tenantId])
}

/// Che cosa mostra un link pubblico (ADR-056).
enum PublicLinkKind {
  QUOTE
  ORDER
}

/// Link pubblico di un preventivo (con accettazione) o di un ordine (stato), da mandare al cliente
/// (ADR-056). Il token non si salva: è firmato dal server (fioreria + ID del link), quindi il
/// fiorista può ricopiarlo quando vuole. Scade e si può disattivare; uno solo attivo per documento.
model PublicLink {
  id          String         @id @default(uuid(7)) @db.Uuid
  tenantId    String         @db.Uuid
  kind        PublicLinkKind
  quoteId     String?        @db.Uuid
  orderId     String?        @db.Uuid
  createdById String?        @db.Uuid
  createdAt   DateTime       @default(now())
  expiresAt   DateTime
  revokedAt   DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  quote  Quote? @relation(fields: [tenantId, quoteId], references: [tenantId, id], onDelete: Restrict)
  order  Order? @relation(fields: [tenantId, orderId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@index([tenantId, quoteId])
  @@index([tenantId, orderId])
}

/// Foto del ramo finito di un ordine (prova di consegna, ADR-058): la scatta chi lo prepara o lo
/// consegna, la vede la fioreria e il cliente dal suo link. Una sola attiva per ordine; cambiandola,
/// la precedente si archivia. File privati sotto `tenants/{tenantId}/order-photos/`.
model OrderPhoto {
  id          String       @id @default(uuid(7)) @db.Uuid
  tenantId    String       @db.Uuid
  orderId     String       @db.Uuid
  storageKey  String
  thumbKey    String
  contentType String
  width       Int
  height      Int
  sizeBytes   Int
  status      RecordStatus @default(ACTIVE)
  archivedAt  DateTime?
  createdById String       @db.Uuid
  createdAt   DateTime     @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order  Order  @relation(fields: [tenantId, orderId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@index([tenantId, orderId, status])
}
