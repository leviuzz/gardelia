// =============================================================================
// Floral OS — schema dati (Prisma 7, PostgreSQL)
//
// Convenzioni (vedi docs/ARCHITECTURE.md e docs/DECISIONS.md):
// - ID: UUID v7 (ordinabili nel tempo), tipo nativo `uuid`.
// - Denaro: interi in unità minime (es. centavos) + valuta ISO 4217 su ogni riga monetaria.
// - Ogni entità di proprietà di un merchant ha `tenantId` ed è protetta da una policy
//   di Row-Level Security definita nelle migrazioni SQL (non esprimibile in Prisma).
// - Le relazioni fra entità dello stesso tenant usano FK composite (tenantId, id):
//   il database rifiuta riferimenti incrociati fra tenant diversi.
// - Date/ore in UTC; il fuso orario di visualizzazione vive su Tenant/Location.
// - Nessuna cancellazione fisica di dati commerciali: si archivia (status ARCHIVED).
// =============================================================================

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// -----------------------------------------------------------------------------
// Identità (globale, non tenant-scoped). Tabelle gestite da Better Auth:
// User, Session, Account, Verification, RateLimit. I nomi dei campi seguono
// lo schema atteso da Better Auth 1.7.
// -----------------------------------------------------------------------------

enum PlatformRole {
  NONE
  SUPER_ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

model User {
  id               String       @id @default(uuid(7)) @db.Uuid
  name             String
  email            String       @unique
  emailVerified    Boolean      @default(false)
  image            String?
  /// Lingua preferita dell'interfaccia (BCP 47), es. "es-MX".
  locale           String       @default("es-MX")
  /// Ruolo di piattaforma: MAI impostabile dall'utente in fase di registrazione.
  platformRole     PlatformRole @default(NONE)
  status           UserStatus   @default(ACTIVE)
  /// Verifica in due passaggi attiva (Better Auth, ADR-077).
  twoFactorEnabled Boolean      @default(false)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  sessions           Session[]
  twoFactors         TwoFactor[]
  accounts           Account[]
  memberships        Membership[]       @relation("MembershipUser")
  invitedMemberships Membership[]       @relation("MembershipInviter")
  sentInvitations    Invitation[]       @relation("InvitationInviter")
  buyerProfile       BuyerProfile?
  buyerOrders        Order[]            @relation("BuyerOrders")
  /// Floral Care, pagina del cliente (ADR-084): i contratti che la persona vede.
  carePortalAccesses CarePortalAccess[] @relation("CarePortalAccessUser")
}

model Session {
  id        String   @id @default(uuid(7)) @db.Uuid
  token     String   @unique
  userId    String   @db.Uuid
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Verifica in due passaggi (Better Auth, ADR-077): segreto dell'app di autenticazione e codici di
/// riserva, cifrati da Better Auth con BETTER_AUTH_SECRET; tentativi falliti e blocco temporaneo.
/// Tabella di identità: senza RLS, come Session e Account (la libreria la legge prima del contesto).
model TwoFactor {
  id                      String    @id @default(uuid(7)) @db.Uuid
  secret                  String
  backupCodes             String
  userId                  String    @db.Uuid
  /// Falso finché la persona non conferma il primo codice.
  verified                Boolean   @default(true)
  failedVerificationCount Int       @default(0)
  lockedUntil             DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Una sola configurazione per persona (Better Auth la aggiorna, non ne aggiunge).
  @@unique([userId])
}

model Account {
  id                    String    @id @default(uuid(7)) @db.Uuid
  accountId             String
  providerId            String
  userId                String    @db.Uuid
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  /// Hash della password (scrypt, gestito da Better Auth). Mai in chiaro.
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
}

model Verification {
  id         String   @id @default(uuid(7)) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

/// Contatori del rate limiting di Better Auth (storage "database", condiviso fra istanze).
model RateLimit {
  id          String @id @default(uuid(7)) @db.Uuid
  key         String @unique
  count       Int
  lastRequest BigInt
}

// -----------------------------------------------------------------------------
// Conto del cliente del marketplace (blocco C1, ADR-064)
// -----------------------------------------------------------------------------
// Dati di chi compra: appartengono alla persona, non a una fioreria. Tabelle di piattaforma con
// RLS per utente (`"userId" = app_current_user_id()`): ognuno vede e modifica solo le sue righe.

/// Si crea la prima volta che la persona apre "Mi cuenta": da lì l'accesso porta al conto
/// cliente invece che alla creazione di una fioreria.
model BuyerProfile {
  userId    String   @id @db.Uuid
  /// Formato E.164 (per la fioreria che consegna).
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  addresses BuyerAddress[]
}

/// Indirizzi di consegna salvati da chi compra (stessi campi della rubrica della fioreria).
model BuyerAddress {
  id             String       @id @default(uuid(7)) @db.Uuid
  userId         String       @db.Uuid
  /// Etichetta libera: "Casa", "Oficina", "Mamá".
  label          String?
  recipientName  String?
  /// Formato E.164.
  recipientPhone String?
  addressLine1   String
  addressLine2   String?
  neighborhood   String?
  city           String
  region         String
  postalCode     String
  /// Google Places (ADR-059): ID del luogo (si conserva) e coordinate, cache di 30 giorni.
  placeId        String?
  latitude       Float?
  longitude      Float?
  coordinatesAt  DateTime?
  countryCode    String       @db.Char(2)
  /// Referencias / entre calles / istruzioni per chi consegna.
  deliveryNotes  String?
  isDefault      Boolean      @default(false)
  status         RecordStatus @default(ACTIVE)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  profile BuyerProfile @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@index([userId])
}

// -----------------------------------------------------------------------------
// Tenancy
// -----------------------------------------------------------------------------

enum TenantStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

/// LIVE = fioreria reale; DEMO = dati dimostrativi (nessuna comunicazione reale verso clienti).
enum TenantMode {
  LIVE
  DEMO
}

enum RecordStatus {
  ACTIVE
  ARCHIVED
}

/// Una fioreria (merchant). Radice dell'isolamento dei dati.
model Tenant {
  id                      String       @id @default(uuid(7)) @db.Uuid
  /// Identificativo URL (/app/{slug}); unico a livello di piattaforma.
  slug                    String       @unique
  displayName             String
  legalName               String?
  /// Identificativo fiscale locale (RFC in Messico). Facoltativo; uso fiscale DA VALIDARE.
  taxId                   String?
  /// ISO 3166-1 alpha-2, es. "MX".
  marketCountry           String       @db.Char(2)
  /// ISO 4217, es. "MXN".
  currency                String       @db.Char(3)
  /// IANA, es. "America/Mexico_City".
  timezone                String
  defaultLocale           String       @default("es-MX")
  contactEmail            String?
  contactPhone            String?
  status                  TenantStatus @default(ACTIVE)
  mode                    TenantMode   @default(LIVE)
  onboardingCompletedAt   DateTime?
  /// Giorni di validità predefiniti di un nuovo preventivo.
  quoteValidityDays       Int          @default(7)
  /// Cargo fisso per l'armado di un bouquet del Builder (unità minime); 0 = nessuno.
  builderLaborFeeMinor    Int          @default(0)
  /// Giorni della settimana in cui la fioreria è chiusa (0 = domenica … 6 = sabato), ADR-055.
  deliveryClosedWeekdays  Int[]        @default([])
  /// Costo di consegna proposto nei nuovi ordini a domicilio (unità minime), ADR-055.
  defaultDeliveryFeeMinor Int          @default(0)
  /// Promo delle date speciali (ADR-047): email automatica con sconto, spenta all'inizio.
  occasionPromoEnabled    Boolean      @default(false)
  occasionPromoKind       DiscountKind @default(PERCENT)
  /// Percentuale intera (1–90) o importo in unità minime; null finché non si sceglie.
  occasionPromoValue      Int?
  /// "Eliminar florería" (ADR-074): chi l'ha chiesta e quando. La fioreria è ARCHIVED e la
  /// manutenzione la cancella davvero da `deleteAfter` (30 giorni dopo); fino ad allora il titolare
  /// la può recuperare. Tutti e tre NULL quando non c'è nessuna eliminazione in corso.
  deletionRequestedAt     DateTime?
  deletionRequestedById   String?      @db.Uuid
  deleteAfter             DateTime?
  createdAt               DateTime     @default(now())
  updatedAt               DateTime     @updatedAt

  locations            Location[]
  memberships          Membership[]
  invitations          Invitation[]
  catalogItems         CatalogItem[]
  recipes              BouquetRecipe[]
  recipeLines          BouquetRecipeLine[]
  inventoryItems       InventoryItem[]
  inventoryEntries     InventoryEntry[]
  inventoryMoves       InventoryMovement[]
  suppliers            Supplier[]
  inventoryHolds       InventoryReservation[]
  inventoryHoldRows    InventoryReservationLine[]
  customers            Customer[]
  customerAddresses    CustomerAddress[]
  customerOccasions    CustomerOccasion[]
  customerImports      CustomerImport[]
  quotes               Quote[]
  quoteLines           QuoteLine[]
  orders               Order[]
  deliveryWindows      DeliveryWindow[]
  openingHours         OpeningHoursRange[]
  deliveryFeeTiers     DeliveryFeeTier[]
  orderLines           OrderLine[]
  orderPayments        OrderPayment[]
  orderEvents          OrderStatusEvent[]
  counters             TenantCounter[]
  aiJobs               AiJob[]
  auditLogs            AuditLog[]
  subscription         TenantSubscription?
  builderConfigs       BouquetConfiguration[]
  bouquetPhotos        BouquetPhoto[]
  builderLines         BouquetConfigurationLine[]
  aiCreditGrants       AiCreditGrant[]
  catalogPhotos        CatalogItemPhoto[]
  styleReferences      StyleReferencePhoto[]
  promoEmails          OccasionPromoEmail[]
  publicLinks          PublicLink[]
  orderPhotos          OrderPhoto[]
  onlineStore          OnlineStore?
  careSettings         CareSettings?
  careTravelTiers      CareTravelTier[]
  careServices         CareService[]
  careSlots            CareSlot[]
  subscriptions        CustomerSubscription[]
  subscriptionSlots    CustomerSubscriptionSlot[]
  subscriptionServices CustomerSubscriptionService[]
  carePlants           CarePlant[]
  careVisits           CareVisit[]
  careServiceResults   CareVisitServiceResult[]
  carePlantResults     CareVisitPlantResult[]
  careMaterials        CareVisitMaterial[]
  carePhotos           CarePhoto[]
  careFollowUps        CareFollowUp[]
  careEmails           CareEmail[]
  careCharges          CareCharge[]
  careChargeLines      CareChargeLine[]
  careVisitBilling     CareVisitBilling[]
  carePayments         CarePayment[]
  careAllocations      CarePaymentAllocation[]
  careAdjustments      CareChargeAdjustment[]
  careBlocks           CareBlock[]
  careBlockVisits      CareBlockVisit[]
  carePortalInvites    CarePortalInvite[]
  carePortalAccesses   CarePortalAccess[]
}

/// Sede operativa. Indirizzo strutturato (mai concatenato in una stringa unica).
model Location {
  id               String       @id @default(uuid(7)) @db.Uuid
  tenantId         String       @db.Uuid
  name             String
  isPrimary        Boolean      @default(false)
  /// Via e numero esterno (MX: calle y número exterior).
  addressLine1     String
  /// Interno/appartamento (MX: número interior).
  addressLine2     String?
  /// MX: colonia.
  neighborhood     String?
  /// MX: municipio / alcaldía.
  city             String
  /// MX: estado (codice, es. "AGU").
  region           String
  postalCode       String
  /// Google Places (ADR-059): ID del luogo (si conserva) e coordinate, cache di 30 giorni.
  placeId          String?
  latitude         Float?
  longitude        Float?
  coordinatesAt    DateTime?
  countryCode      String       @db.Char(2)
  phone            String?
  timezone         String
  deliveryRadiusKm Int?
  status           RecordStatus @default(ACTIVE)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  tenant       Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  openingHours OpeningHoursRange[]

  @@unique([tenantId, id])
  @@index([tenantId])
}

/// Orari di apertura della tienda (V1 §2.2): zero o più fasce per giorno della settimana; un giorno
/// senza fasce è chiuso, nessuna fascia nella settimana = orario non indicato. Si sostituiscono
/// tutte insieme dalle impostazioni (sono configurazione, non dati commerciali).
model OpeningHoursRange {
  id           String   @id @default(uuid(7)) @db.Uuid
  tenantId     String   @db.Uuid
  locationId   String   @db.Uuid
  /// 0 = domenica … 6 = sabato.
  weekday      Int
  /// Minuti dalla mezzanotte nel fuso della fioreria, stesso giorno (start < end).
  startMinutes Int
  endMinutes   Int
  createdAt    DateTime @default(now())

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  location Location @relation(fields: [tenantId, locationId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, id])
  @@unique([tenantId, locationId, weekday, startMinutes])
  @@index([tenantId])
}

enum MembershipRole {
  OWNER
  MANAGER
  STAFF
}

enum MembershipStatus {
  ACTIVE
  SUSPENDED
}

/// Appartenenza di un utente a un tenant con un ruolo.
model Membership {
  id            String           @id @default(uuid(7)) @db.Uuid
  tenantId      String           @db.Uuid
  userId        String           @db.Uuid
  role          MembershipRole
  status        MembershipStatus @default(ACTIVE)
  invitedById   String?          @db.Uuid
  deactivatedAt DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  tenant         Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user           User        @relation("MembershipUser", fields: [userId], references: [id], onDelete: Cascade)
  invitedBy      User?       @relation("MembershipInviter", fields: [invitedById], references: [id], onDelete: SetNull)
  /// Ordini da consegnare assegnati a questo membro (repartidor, ADR-058).
  assignedOrders Order[]
  /// Visite di Floral Care assegnate a questo membro (ADR-075).
  careVisits     CareVisit[]

  @@unique([tenantId, userId])
  @@unique([tenantId, id])
  @@index([userId])
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

/// Invito a entrare in un tenant. Il token in chiaro esiste solo nell'email: qui se ne salva l'hash.
model Invitation {
  id           String           @id @default(uuid(7)) @db.Uuid
  tenantId     String           @db.Uuid
  /// Email normalizzata (minuscolo). L'invito può essere accettato solo da quell'email.
  email        String
  role         MembershipRole
  tokenHash    String           @unique
  status       InvitationStatus @default(PENDING)
  expiresAt    DateTime
  invitedById  String           @db.Uuid
  acceptedById String?          @db.Uuid
  acceptedAt   DateTime?
  revokedAt    DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invitedBy User   @relation("InvitationInviter", fields: [invitedById], references: [id], onDelete: Cascade)

  @@unique([tenantId, id])
  @@index([tenantId, status])
  @@index([tenantId, email])
}

/// Registro append-only delle modifiche critiche e degli eventi di sicurezza.
/// tenantId NULL = evento di piattaforma (visibile solo agli admin di piattaforma).
model AuditLog {
  id          String   @id @default(uuid(7)) @db.Uuid
  tenantId    String?  @db.Uuid
  /// Nessuna FK: il registro deve sopravvivere alla cancellazione dell'utente.
  actorUserId String?  @db.Uuid
  action      String
  entityType  String
  entityId    String?
  metadata    Json?
  requestId   String?
  ipAddress   String?
  createdAt   DateTime @default(now())

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt(sort: Desc)])
  @@index([entityType, entityId])
}

// -----------------------------------------------------------------------------
// Catalogo
// -----------------------------------------------------------------------------

enum CanonicalCategory {
  CUT_FLOWER
  FOLIAGE
  PLANT
}

/// Tassonomia normalizzata globale (rosa, tulipano, ...). Non appartiene a nessun tenant;
/// gli SKU dei fioristi possono collegarvisi per ricerca, Builder e matching futuro.
model CanonicalFlower {
  id             String            @id @default(uuid(7)) @db.Uuid
  slug           String            @unique
  scientificName String
  category       CanonicalCategory
  /// Nomi localizzati: { "es-MX": "Rosa", "it-IT": "Rosa", "en-US": "Rose" }.
  names          Json
  /// Altri nomi per lingua (ricerca e specie suggerita dal nome): { "es-MX": ["Nube"] }.
  synonyms       Json              @default("{}")
  colors         String[]
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  catalogItems CatalogItem[]
  carePlants   CarePlant[]
}

enum CatalogItemType {
  CUT_FLOWER
  FOLIAGE
  PLANT
  BOUQUET
  CONTAINER
  PACKAGING
  ACCESSORY
  SERVICE
  SERVICE_ADDON
}

enum SaleUnit {
  STEM
  BUNCH
  PIECE
  SERVICE
}

enum Availability {
  AVAILABLE
  LIMITED
  OUT_OF_STOCK
  ON_REQUEST
}

/// SKU di un singolo fiorista (prezzo, varietà e disponibilità propri).
/// "Mi tienda en línea" (blocco C2, ADR-065): la pagina pubblica della fioreria. Una riga per
/// fioreria, creata la prima volta che si salvano le impostazioni.
model OnlineStore {
  tenantId            String    @id @db.Uuid
  /// Visibile a tutti in /f/<slug>.
  isPublished         Boolean   @default(false)
  publishedAt         DateTime?
  description         String?
  /// Chiavi di STORE_PAYMENT_METHODS (@floral/domain): solo informazione per il cliente.
  paymentMethods      String[]  @default([])
  /// Testo pubblico (es. CLABE e banca per il trasferimento).
  paymentInstructions String?
  /// Logo (JPEG piccolo) e foto di copertina (JPEG grande): l'ID cambia a ogni sostituzione ed è
  /// nell'indirizzo pubblico, così il browser non mostra mai la versione vecchia.
  logoId              String?   @db.Uuid
  logoKey             String?
  coverId             String?   @db.Uuid
  coverKey            String?
  /// Pedidos en línea (blocco C4): il cliente ordina dalla pagina; spento = solo WhatsApp.
  ordersEnabled       Boolean   @default(false)
  /// Giorni di anticipo minimo per un ordine online (0 = anche per oggi).
  minLeadDays         Int       @default(1)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model CatalogItem {
  id                     String          @id @default(uuid(7)) @db.Uuid
  tenantId               String          @db.Uuid
  type                   CatalogItemType
  name                   String
  description            String?
  /// Codice interno facoltativo, unico per tenant.
  sku                    String?
  canonicalFlowerId      String?         @db.Uuid
  variety                String?
  /// Chiavi colore controllate (vedi @floral/domain CATALOG_COLORS).
  colors                 String[]
  saleUnit               SaleUnit
  /// Prezzo di vendita per unità di vendita, in unità minime.
  priceMinor             Int
  /// Costo stimato per unità di vendita, in unità minime. NULL = non compilato.
  costMinor              Int?
  currency               String          @db.Char(3)
  availability           Availability    @default(AVAILABLE)
  /// Minuti per armarlo (ramos) o prepararlo: stima per la Producción del día (ADR-081).
  prepMinutes            Int?
  heightCm               Int?
  widthCm                Int?
  /// Proveedor habitual (ADR-081): da chi si compra di solito; serve per riordinare.
  supplierId             String?         @db.Uuid
  /// Servizi (ADR-081): durata indicativa in minuti e raggio in km dalla fioreria. NULL = non detto.
  serviceDurationMinutes Int?
  serviceRadiusKm        Int?
  tags                   String[]
  /// Utilizzabile come componente nel Bouquet Builder [AI-BQ-01].
  isBuilderEnabled       Boolean         @default(false)
  /// Mostrato nella pagina pubblica della fioreria ("Mi tienda en línea", blocco C2).
  isOnline               Boolean         @default(false)
  status                 RecordStatus    @default(ACTIVE)
  archivedAt             DateTime?
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt

  tenant          Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  canonicalFlower CanonicalFlower?           @relation(fields: [canonicalFlowerId], references: [id], onDelete: SetNull)
  supplier        Supplier?                  @relation(fields: [tenantId, supplierId], references: [tenantId, id], onDelete: Restrict)
  recipe          BouquetRecipe?
  usedInRecipes   BouquetRecipeLine[]        @relation("RecipeIngredient")
  quoteLines      QuoteLine[]
  orderLines      OrderLine[]
  builderLines    BouquetConfigurationLine[]
  photos          CatalogItemPhoto[]
  inventoryItem   InventoryItem?
  careMaterials   CareVisitMaterial[]

  @@unique([tenantId, id])
  @@unique([tenantId, sku])
  @@index([tenantId, status, type])
  @@index([tenantId, supplierId])
}

enum SubstitutionPolicy {
  /// Chiedere conferma al cliente prima di sostituire un ingrediente.
  ASK_CUSTOMER
  /// Sostituzione consentita con ingrediente simile (stesso colore/categoria).
  SIMILAR_ALLOWED
  /// Nessuna sostituzione: se manca un ingrediente il bouquet non è producibile.
  NOT_ALLOWED
}

/// Distinta base (BOM) di un bouquet. È la fonte di verità per composizione e costi,
/// mai l'immagine generata dall'AI.
model BouquetRecipe {
  id                 String             @id @default(uuid(7)) @db.Uuid
  tenantId           String             @db.Uuid
  /// CatalogItem di tipo BOUQUET (relazione 1:1).
  catalogItemId      String             @db.Uuid
  /// Costo stimato della manodopera, in unità minime. NULL = non compilato.
  laborCostMinor     Int?
  styleTags          String[]
  notes              String?
  substitutionPolicy SubstitutionPolicy @default(ASK_CUSTOMER)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  tenant      Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  catalogItem CatalogItem         @relation(fields: [tenantId, catalogItemId], references: [tenantId, id], onDelete: Cascade)
  lines       BouquetRecipeLine[]

  @@unique([tenantId, id])
  @@unique([tenantId, catalogItemId])
}

model BouquetRecipeLine {
  id               String   @id @default(uuid(7)) @db.Uuid
  tenantId         String   @db.Uuid
  recipeId         String   @db.Uuid
  ingredientItemId String   @db.Uuid
  /// Quantità intera positiva nell'unità di vendita dell'ingrediente (CHECK > 0 nel DB).
  quantity         Int
  sortOrder        Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  tenant     Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  recipe     BouquetRecipe @relation(fields: [tenantId, recipeId], references: [tenantId, id], onDelete: Cascade)
  ingredient CatalogItem   @relation("RecipeIngredient", fields: [tenantId, ingredientItemId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, recipeId, ingredientItemId])
  @@index([tenantId, ingredientItemId])
}

// -----------------------------------------------------------------------------
// Inventario [INV-01] (ADR-060): giacenze dei prodotti del catalogo e registri di magazzino
// -----------------------------------------------------------------------------

/// Tipo di registro di magazzino. Il segno delle quantità dipende dal tipo (CHECK nel DB).
enum InventoryEntryKind {
  /// Existencia inicial, quando si comincia a controllare un prodotto.
  OPENING
  /// Compra al mayorista.
  PURCHASE
  /// Uso: merce usata per un ramo o venduta.
  USE
  /// Merma: merce buttata (appassita, rovinata).
  WASTE
  /// Ajuste: la differenza trovata con un conteggio fisico.
  ADJUSTMENT
  /// Anulación di un registro sbagliato: movimenti opposti, mai una cancellazione.
  REVERSAL
}

/// Prodotto del catalogo di cui la fioreria controlla la giacenza (uno per prodotto).
/// La giacenza cambia solo insieme a un movimento, nella stessa transazione.
model InventoryItem {
  id               String       @id @default(uuid(7)) @db.Uuid
  tenantId         String       @db.Uuid
  catalogItemId    String       @db.Uuid
  /// Giacenza nell'unità di vendita del prodotto; sotto zero solo con conferma.
  onHand           Int          @default(0)
  /// Costo reale medio per unità (media ponderata degli ingressi), unità minime. NULL = non noto.
  avgUnitCostMinor Int?
  currency         String       @db.Char(3)
  /// "Avísame cuando queden": avviso quando il disponibile scende a questo numero. NULL = nessuno.
  minQuantity      Int?
  /// ARCHIVED = la fioreria non lo controlla più (lo storico resta).
  status           RecordStatus @default(ACTIVE)
  archivedAt       DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  tenant      Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  catalogItem CatalogItem                @relation(fields: [tenantId, catalogItemId], references: [tenantId, id], onDelete: Restrict)
  movements   InventoryMovement[]
  holds       InventoryReservationLine[]

  @@unique([tenantId, id])
  @@unique([tenantId, catalogItemId])
  @@index([tenantId, status])
}

/// Registro di magazzino: un'operazione con una o più righe. Solo lettura e inserimento (RLS):
/// uno sbaglio si annulla con un registro REVERSAL.
model InventoryEntry {
  id              String             @id @default(uuid(7)) @db.Uuid
  tenantId        String             @db.Uuid
  kind            InventoryEntryKind
  note            String?
  /// Solo per REVERSAL: il registro annullato (una sola anulación per registro).
  reversesEntryId String?            @db.Uuid
  /// Solo per PURCHASE: proveedor (facoltativo), factura o nota, giorno della compra.
  supplierId      String?            @db.Uuid
  reference       String?
  purchasedOn     DateTime?          @db.Date
  createdById     String?            @db.Uuid
  /// Quando è successo (es. il giorno della compra); di solito coincide con createdAt.
  occurredAt      DateTime           @default(now())
  createdAt       DateTime           @default(now())

  tenant      Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  supplier    Supplier?             @relation(fields: [tenantId, supplierId], references: [tenantId, id], onDelete: Restrict)
  reverses    InventoryEntry?       @relation("InventoryReversal", fields: [tenantId, reversesEntryId], references: [tenantId, id], onDelete: Restrict)
  reversedBy  InventoryEntry?       @relation("InventoryReversal")
  movements   InventoryMovement[]
  /// L'apartado usato con questo registro (ADR-062).
  reservation InventoryReservation?
  /// L'ordine scaricato con questo registro (ADR-071).
  order       Order?
  /// La visita di Floral Care che ha usato i materiali (ADR-078).
  careVisit   CareVisit?

  @@unique([tenantId, id])
  /// Bersaglio della FK dei movimenti: il tipo del movimento è sempre quello del registro.
  @@unique([tenantId, id, kind])
  @@unique([tenantId, reversesEntryId])
  @@index([tenantId, occurredAt])
}

enum InventoryReservationStatus {
  /// Tiene la merce fino alla fine del giorno di scadenza (poi è vencido, senza job).
  ACTIVE
  /// Usato: la merce è uscita con un registro di uso.
  USED
  /// Liberato a mano: la merce torna disponibile.
  RELEASED
}

/// Apartado (ADR-062): merce messa da parte per un evento o un cliente fino a una data. Non cambia
/// la giacenza: toglie merce dal disponibile finché vale.
model InventoryReservation {
  id          String                     @id @default(uuid(7)) @db.Uuid
  tenantId    String                     @db.Uuid
  /// "Para": l'evento o il cliente ("Boda de Ana").
  label       String
  note        String?
  /// Ultimo giorno in cui vale, nel calendario della fioreria.
  expiresOn   DateTime                   @db.Date
  /// Da quando toglie merce dal disponibile; NULL = da subito. Gli apartados degli ordini tengono
  /// solo negli ultimi giorni prima della consegna (ADR-072). CHECK: non dopo la scadenza.
  holdsFrom   DateTime?                  @db.Date
  status      InventoryReservationStatus @default(ACTIVE)
  /// Solo per USED: il registro di uso (nessuno se non restava nulla da registrare).
  usedEntryId String?                    @db.Uuid
  closedAt    DateTime?
  closedById  String?                    @db.Uuid
  createdById String?                    @db.Uuid
  createdAt   DateTime                   @default(now())
  updatedAt   DateTime                   @updatedAt

  tenant    Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  usedEntry InventoryEntry?            @relation(fields: [tenantId, usedEntryId], references: [tenantId, id], onDelete: Restrict)
  lines     InventoryReservationLine[]
  /// Ordine che lo tiene (ADR-072): un apartado di un ordine si usa e si libera solo dall'ordine.
  order     Order?

  @@unique([tenantId, id])
  @@unique([tenantId, usedEntryId])
  @@index([tenantId, status, expiresOn])
}

/// Riga di un apartado: un prodotto controllato e quanto se ne mette da parte.
model InventoryReservationLine {
  id              String   @id @default(uuid(7)) @db.Uuid
  tenantId        String   @db.Uuid
  reservationId   String   @db.Uuid
  inventoryItemId String   @db.Uuid
  quantity        Int
  /// Quanto si è usato davvero quando l'apartado è stato usato (NULL prima).
  usedQuantity    Int?
  createdAt       DateTime @default(now())

  tenant      Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  reservation InventoryReservation @relation(fields: [tenantId, reservationId], references: [tenantId, id], onDelete: Restrict)
  item        InventoryItem        @relation(fields: [tenantId, inventoryItemId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@unique([reservationId, inventoryItemId])
  @@index([tenantId, inventoryItemId])
}

/// Proveedor della fioreria (mayorista, mercado) per le compras (ADR-061). Si archivia, non si cancella.
model Supplier {
  id         String       @id @default(uuid(7)) @db.Uuid
  tenantId   String       @db.Uuid
  name       String
  phone      String?
  notes      String?
  status     RecordStatus @default(ACTIVE)
  archivedAt DateTime?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  tenant       Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  purchases    InventoryEntry[]
  catalogItems CatalogItem[]

  @@unique([tenantId, id])
  @@index([tenantId, status, name])
}

/// Riga di un registro: di quanto cambia la giacenza di un prodotto e a che costo.
model InventoryMovement {
  id                    String             @id @default(uuid(7)) @db.Uuid
  tenantId              String             @db.Uuid
  entryId               String             @db.Uuid
  /// Uguale al tipo del registro (FK composita): permette il CHECK sul segno.
  kind                  InventoryEntryKind
  inventoryItemId       String             @db.Uuid
  /// Variazione della giacenza, con segno, nell'unità di vendita del prodotto.
  quantity              Int
  /// Giacenza del prodotto subito dopo questo movimento.
  balanceAfter          Int
  /// Costo reale per unità: prezzo della compra o costo medio al momento. NULL = non noto.
  unitCostMinor         Int?
  /// Costo del catalogo al momento (costo previsto). NULL = non compilato.
  expectedUnitCostMinor Int?
  /// Solo per PURCHASE: totale pagato per la riga (il costo per unità è arrotondato).
  totalCostMinor        Int?
  currency              String             @db.Char(3)
  createdAt             DateTime           @default(now())

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  entry         InventoryEntry @relation(fields: [tenantId, entryId, kind], references: [tenantId, id, kind], onDelete: Restrict)
  inventoryItem InventoryItem  @relation(fields: [tenantId, inventoryItemId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@unique([tenantId, entryId, inventoryItemId])
  @@index([tenantId, inventoryItemId, createdAt])
}

// -----------------------------------------------------------------------------
// CRM (confine dati Sprint 0; funzionalità complete nello Sprint 1)
// -----------------------------------------------------------------------------

enum CustomerType {
  PERSON
  COMPANY
}

/// Origine del cliente/ordine: determina l'attribuzione delle commissioni future.
/// MERCHANT_DIRECT, IMPORT e MANUAL non generano MAI fee marketplace.
enum AcquisitionSource {
  MERCHANT_DIRECT
  NETWORK_B2B
  MARKETPLACE_B2C
  IMPORT
  MANUAL
}

model Customer {
  id                 String            @id @default(uuid(7)) @db.Uuid
  tenantId           String            @db.Uuid
  type               CustomerType      @default(PERSON)
  displayName        String
  legalName          String?
  taxId              String?
  email              String?
  /// Formato E.164, es. "+524491234567".
  phone              String?
  notes              String?
  /// Preferenze floreali (testo libero del fiorista).
  preferences        String?
  /// Restrizioni note (allergie, fiori da evitare).
  restrictions       String?
  tags               String[]
  acquisitionSource  AcquisitionSource @default(MERCHANT_DIRECT)
  acquisitionChannel String?
  marketingConsent   Boolean           @default(false)
  marketingConsentAt DateTime?
  status             RecordStatus      @default(ACTIVE)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  tenant        Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  quotes        Quote[]
  orders        Order[]
  addresses     CustomerAddress[]
  occasions     CustomerOccasion[]
  promoEmails   OccasionPromoEmail[]
  subscriptions CustomerSubscription[]
  careCharges   CareCharge[]
  carePayments  CarePayment[]
  portalInvites CarePortalInvite[]
  portalAccess  CarePortalAccess[]

  @@unique([tenantId, id])
  @@index([tenantId, status])
}

/// Indirizzo di consegna di un cliente (anche di un destinatario regalo).
/// Il destinatario NON diventa un contatto marketing (spec §5.2).
model CustomerAddress {
  id             String       @id @default(uuid(7)) @db.Uuid
  tenantId       String       @db.Uuid
  customerId     String       @db.Uuid
  /// Etichetta libera: "Casa", "Oficina", "Mamá".
  label          String?
  recipientName  String?
  /// Formato E.164.
  recipientPhone String?
  addressLine1   String
  addressLine2   String?
  neighborhood   String?
  city           String
  region         String
  postalCode     String
  /// Google Places (ADR-059): ID del luogo (si conserva) e coordinate, cache di 30 giorni.
  placeId        String?
  latitude       Float?
  longitude      Float?
  coordinatesAt  DateTime?
  countryCode    String       @db.Char(2)
  /// Referencias / entre calles / istruzioni per il corriere.
  deliveryNotes  String?
  isDefault      Boolean      @default(false)
  status         RecordStatus @default(ACTIVE)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  tenant        Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer      Customer               @relation(fields: [tenantId, customerId], references: [tenantId, id], onDelete: Cascade)
  orders        Order[]
  /// Sedi dei contratti di Floral Care (ADR-075).
  subscriptions CustomerSubscription[]

  @@unique([tenantId, id])
  @@index([tenantId, customerId])
}

enum OccasionType {
  BIRTHDAY
  ANNIVERSARY
  CUSTOM
}

/// Ricorrenza da ricordare (compleanno, anniversario, data personalizzata).
/// `personName` valorizzato = ricorrenza di un destinatario, non del cliente stesso.
model CustomerOccasion {
  id               String       @id @default(uuid(7)) @db.Uuid
  tenantId         String       @db.Uuid
  customerId       String       @db.Uuid
  type             OccasionType
  /// Obbligatoria per CUSTOM (es. "Día de las madres").
  label            String?
  personName       String?
  month            Int
  day              Int
  /// Anno facoltativo (es. anno di nascita o del matrimonio).
  year             Int?
  remindDaysBefore Int          @default(7)
  notes            String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  tenant      Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer    Customer             @relation(fields: [tenantId, customerId], references: [tenantId, id], onDelete: Cascade)
  promoEmails OccasionPromoEmail[]

  @@unique([tenantId, id])
  @@index([tenantId, month, day])
  @@index([tenantId, customerId])
}

/// Stato di un import di clienti da CSV (ADR-070): bozza con anteprima, importato o annullato.
enum CustomerImportStatus {
  DRAFT
  DONE
  CANCELLED
}

/// Import di clienti da un file CSV (ADR-070): il file resta qui solo finché è una bozza
/// (anteprima e scelta delle colonne); importato o annullato, il testo si svuota e restano i conti.
model CustomerImport {
  id            String               @id @default(uuid(7)) @db.Uuid
  tenantId      String               @db.Uuid
  fileName      String
  /// Testo del file (vuoto dopo l'import o l'annullamento).
  content       String
  /// Colonna → dato del cliente (null: ignorata), nell'ordine delle colonne.
  mapping       Json
  status        CustomerImportStatus @default(DRAFT)
  /// Righe di dati del file (intestazione esclusa).
  rowCount      Int
  importedCount Int                  @default(0)
  skippedCount  Int                  @default(0)
  createdById   String?              @db.Uuid
  completedAt   DateTime?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, id])
  @@index([tenantId, status, createdAt])
}

/// Sconto della promo: percentuale intera o importo fisso in unità minime.
enum DiscountKind {
  PERCENT
  AMOUNT
}

enum PromoEmailStatus {
  /// Presa in carico, invio in corso.
  SENDING
  SENT
  /// Non partita: si riprova nei giorni seguenti, fino a 3 tentativi, se la data non è passata.
  FAILED
}

/// Email della promo per una ricorrenza di una data speciale (ADR-047): al massimo una per data e
/// anno. Conserva lo sconto promesso anche se la fioreria lo cambia dopo. Nessun indirizzo email.
model OccasionPromoEmail {
  id             String           @id @default(uuid(7)) @db.Uuid
  tenantId       String           @db.Uuid
  occasionId     String           @db.Uuid
  customerId     String           @db.Uuid
  /// Giorno della ricorrenza (fino a cui vale lo sconto).
  occurrenceDate DateTime         @db.Date
  status         PromoEmailStatus @default(SENDING)
  attempts       Int              @default(1)
  discountKind   DiscountKind
  discountValue  Int
  currency       String           @db.Char(3)
  sentAt         DateTime?
  /// Motivo dell'ultimo fallimento (codice, es. `send_failed`), mai testo del provider.
  lastError      String?
  /// Codice personale dello sconto (6 caratteri, senza trattino), unico nella fioreria (ADR-048).
  code           String
  /// Sconto usato: quando, chi della fioreria l'ha segnato e una nota facoltativa.
  redeemedAt     DateTime?
  /// Nessuna FK, come negli altri riferimenti a chi ha agito: il dato resta anche senza l'utente.
  redeemedById   String?          @db.Uuid
  redemptionNote String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  tenant   Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  occasion CustomerOccasion @relation(fields: [tenantId, occasionId], references: [tenantId, id], onDelete: Cascade)
  customer Customer         @relation(fields: [tenantId, customerId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, id])
  @@unique([tenantId, occasionId, occurrenceDate])
  @@unique([tenantId, code])
  @@index([tenantId, occurrenceDate])
  @@index([tenantId, customerId])
}

// -----------------------------------------------------------------------------
// Preventivi (confine dati Sprint 0; flusso completo nello Sprint 1)
// -----------------------------------------------------------------------------

enum QuoteTaxMode {
  /// Prezzi finali al cliente, nessun calcolo d'imposta (finché O-06 non è validata).
  PRICES_FINAL
}

enum QuoteLineKind {
  /// Articolo del catalogo (prezzo e distinta presi dal listino al momento dell'aggiunta).
  CATALOG_ITEM
  /// Riga libera con prezzo indicato dal fiorista (es. consegna, allestimento speciale).
  CUSTOM
  /// Bouquet composto nel Builder: prezzo e distinta esatta calcolati sul server.
  BUILDER
}

/// Contatori progressivi per tenant (numerazione preventivi, ordini…), incrementati
/// atomicamente nella stessa transazione del documento: niente buchi né duplicati.
model TenantCounter {
  tenantId  String   @db.Uuid
  key       String
  value     Int
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@id([tenantId, key])
}

enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
  CANCELLED
}

model Quote {
  id                String            @id @default(uuid(7)) @db.Uuid
  tenantId          String            @db.Uuid
  /// Numero progressivo per tenant, assegnato dal servizio.
  number            Int
  customerId        String            @db.Uuid
  /// Titolo facoltativo (es. "Arreglo para recepción").
  title             String?
  status            QuoteStatus       @default(DRAFT)
  statusChangedAt   DateTime?
  currency          String            @db.Char(3)
  /// Come sono trattate le imposte. PRICES_FINAL = prezzi finali senza scorporo (O-06 aperta).
  taxMode           QuoteTaxMode      @default(PRICES_FINAL)
  subtotalMinor     Int               @default(0)
  discountMinor     Int               @default(0)
  taxMinor          Int               @default(0)
  totalMinor        Int               @default(0)
  /// Data (senza ora) fino a cui il preventivo è valido, nel calendario del tenant.
  validUntil        DateTime?         @db.Date
  notes             String?
  acquisitionSource AcquisitionSource @default(MERCHANT_DIRECT)
  /// Contratto di Floral Care da cui nasce (cambio di stagione, reposición, extra; ADR-078).
  subscriptionId    String?           @db.Uuid
  createdById       String?           @db.Uuid
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  tenant        Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer      Customer              @relation(fields: [tenantId, customerId], references: [tenantId, id], onDelete: Restrict)
  subscription  CustomerSubscription? @relation(fields: [tenantId, subscriptionId], references: [tenantId, id], onDelete: Restrict)
  lines         QuoteLine[]
  order         Order?
  publicLinks   PublicLink[]
  careVisits    CareVisit[]
  careFollowUps CareFollowUp[]

  @@unique([tenantId, id])
  @@unique([tenantId, number])
  @@index([tenantId, status])
  @@index([tenantId, subscriptionId])
}

model QuoteLine {
  id                     String        @id @default(uuid(7)) @db.Uuid
  tenantId               String        @db.Uuid
  quoteId                String        @db.Uuid
  kind                   QuoteLineKind @default(CATALOG_ITEM)
  /// NULL per righe libere (non a catalogo).
  catalogItemId          String?       @db.Uuid
  /// Solo per righe BUILDER: il disegno da cui è nata la riga.
  bouquetConfigurationId String?       @db.Uuid
  description            String
  quantity               Int
  unitPriceMinor         Int
  /// Snapshot del costo al momento del preventivo (NULL = non compilato).
  unitCostMinor          Int?
  lineTotalMinor         Int
  /// Snapshot dell'articolo (nome, tipo, distinta) al momento del preventivo.
  snapshot               Json?
  /// Solo per righe BUILDER: anteprima AI riuscita del ramo quando la riga è nata (ADR-035).
  previewJobId           String?       @db.Uuid
  /// Solo per righe BUILDER: foto vera del ramo caricata dalla fioreria (ADR-052); se c'è, si
  /// mostra al posto dell'anteprima AI.
  bouquetPhotoId         String?       @db.Uuid
  sortOrder              Int           @default(0)
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt

  tenant               Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  quote                Quote                 @relation(fields: [tenantId, quoteId], references: [tenantId, id], onDelete: Cascade)
  catalogItem          CatalogItem?          @relation(fields: [tenantId, catalogItemId], references: [tenantId, id], onDelete: Restrict)
  bouquetConfiguration BouquetConfiguration? @relation(fields: [tenantId, bouquetConfigurationId], references: [tenantId, id], onDelete: Restrict)
  previewJob           AiJob?                @relation(fields: [tenantId, previewJobId], references: [tenantId, id], onDelete: Restrict)
  bouquetPhoto         BouquetPhoto?         @relation(fields: [tenantId, bouquetPhotoId], references: [tenantId, id], onDelete: Restrict)

  @@index([tenantId, quoteId])
  @@index([tenantId, bouquetConfigurationId])
  @@index([tenantId, previewJobId])
  @@index([tenantId, bouquetPhotoId])
}

// -----------------------------------------------------------------------------
// Job AI (confine dati Sprint 0; pipeline reale nello Sprint 2)
// -----------------------------------------------------------------------------

enum AiFeature {
  BOUQUET_PREVIEW
  ROOM_PREVIEW
  /// Scontorno delle foto del catalogo (ADR-033): costo della piattaforma, non consuma crediti.
  PHOTO_CUTOUT
}

enum AiJobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}

model AiJob {
  id                     String         @id @default(uuid(7)) @db.Uuid
  tenantId               String         @db.Uuid
  feature                AiFeature
  status                 AiJobStatus    @default(QUEUED)
  requestedById          String         @db.Uuid
  /// Disegno del Builder per cui è stata richiesta l'anteprima (il primo richiedente).
  bouquetConfigurationId String?        @db.Uuid
  /// Da dove è stato scalato il credito (quota del mese o extra); null = non consuma.
  quotaSource            AiQuotaSource?
  /// Hash della configurazione normalizzata (caching delle preview identiche, per tenant).
  inputHash              String
  input                  Json
  output                 Json?
  provider               String?
  model                  String?
  promptVersion          String?
  attempts               Int            @default(0)
  maxAttempts            Int            @default(3)
  errorCode              String?
  errorMessage           String?
  /// Crediti consumati secondo la policy di quota (0 finché il job non riesce).
  usageUnits             Int            @default(0)
  /// Costo stimato all'accodamento (micro-USD), per il tetto di spesa della piattaforma.
  estimatedCostMicros    Int            @default(0)
  /// Coda (ADR-025): prossimo tentativo e scadenza del lease del worker.
  runAfter               DateTime       @default(now())
  lockedUntil            DateTime?
  /// Immagine prodotta nell'archivio (chiave `tenants/{tenantId}/…`).
  outputKey              String?
  outputContentType      String?
  /// Costo del provider per la piattaforma, in micro-unità della valuta indicata.
  providerCostMicros     Int?
  providerCurrency       String?        @db.Char(3)
  startedAt              DateTime?
  finishedAt             DateTime?
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt

  tenant               Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  bouquetConfiguration BouquetConfiguration? @relation(fields: [tenantId, bouquetConfigurationId], references: [tenantId, id], onDelete: Restrict)
  quoteLines           QuoteLine[]
  orderLines           OrderLine[]

  @@unique([tenantId, id])
  @@index([tenantId, feature, createdAt])
  @@index([tenantId, inputHash])
  @@index([status, runAfter])
}

enum AiQuotaSource {
  INCLUDED
  EXTRA
}

/// Crediti AI extra (pacchetti pagati alla piattaforma) sbloccati dalla CLI di piattaforma
/// (ADR-024). Il tenant li legge, non li scrive. Non scadono.
model AiCreditGrant {
  id          String    @id @default(uuid(7)) @db.Uuid
  tenantId    String    @db.Uuid
  feature     AiFeature
  units       Int
  /// Riferimento interno (es. pagamento ricevuto): mai dati personali.
  note        String?
  grantedById String    @db.Uuid
  createdAt   DateTime  @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, feature, createdAt])
}

// -----------------------------------------------------------------------------
// Piani SaaS e abbonamenti [BILL-01]. Nessun prezzo (D-16 PROPOSTO) né pagamento:
// nel pilota l'abbonamento è assegnato manualmente da un admin di piattaforma (C-03).
// -----------------------------------------------------------------------------

enum PlanCode {
  BASIC
  PLUS
}

enum SubscriptionStatus {
  PILOT
  TRIALING
  ACTIVE
  CANCELLED
}

enum SubscriptionSource {
  /// Assegnato da un admin di piattaforma (CLI `pnpm platform:assign-plan`).
  MANUAL
}

/// Dati di piattaforma (non del merchant): leggibili da tutti, scrivibili solo in contesto
/// di sistema. I piani BASIC e PLUS sono creati dalla migrazione.
model SaasPlan {
  id           String   @id @default(uuid(7)) @db.Uuid
  code         PlanCode @unique
  /// Validati da `planEntitlementsSchema` (@floral/domain); malformati = nessun accesso.
  entitlements Json
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  subscriptions TenantSubscription[]
}

/// Abbonamento corrente della fioreria: il merchant lo legge, solo la piattaforma lo scrive.
/// Senza abbonamento valido si applica il piano predefinito (BASIC).
model TenantSubscription {
  id                 String             @id @default(uuid(7)) @db.Uuid
  tenantId           String             @unique @db.Uuid
  planId             String             @db.Uuid
  status             SubscriptionStatus
  source             SubscriptionSource @default(MANUAL)
  currentPeriodStart DateTime           @default(now())
  /// null = senza scadenza (es. pilota a tempo indeterminato).
  currentPeriodEnd   DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  tenant Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan   SaasPlan @relation(fields: [planId], references: [id], onDelete: Restrict)

  @@index([planId])
}

// -----------------------------------------------------------------------------
// Bouquet Builder deterministico [AI-BQ-01…04, 06]. Il prezzo lo calcola il server con
// `priceBouquet` (@floral/domain); i prezzi salvati sono uno snapshot "al salvataggio".
// -----------------------------------------------------------------------------

enum BouquetStyle {
  ROMANTIC
  CLASSIC
  MODERN
  GARDEN
  MINIMAL
  TROPICAL
}

enum BouquetSize {
  SMALL
  MEDIUM
  LARGE
  EXTRA_LARGE
}

enum BuilderRole {
  FLOWER
  FOLIAGE
  PACKAGING
  ACCESSORY
}

model BouquetConfiguration {
  id                 String        @id @default(uuid(7)) @db.Uuid
  tenantId           String        @db.Uuid
  name               String
  style              BouquetStyle?
  size               BouquetSize?
  /// Budget indicato dal cliente (orientativo, non cambia il prezzo).
  budgetMinor        Int?
  notes              String?
  currency           String        @db.Char(3)
  componentsMinor    Int
  laborMinor         Int
  totalMinor         Int
  /// Costo materiali al salvataggio; NULL se manca un costo.
  estimatedCostMinor Int?
  pricingVersion     String
  status             RecordStatus  @default(ACTIVE)
  archivedAt         DateTime?
  createdById        String        @db.Uuid
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  tenant     Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lines      BouquetConfigurationLine[]
  quoteLines QuoteLine[]
  orderLines OrderLine[]
  aiJobs     AiJob[]
  photos     BouquetPhoto[]

  @@unique([tenantId, id])
  @@index([tenantId, status, updatedAt])
}

/// Foto vera di un ramo del Diseñador, caricata dalla fioreria invece di generarla (ADR-052).
/// Una sola ATTIVA per disegno (indice parziale nel SQL); cambiandola, la precedente si archivia
/// e resta ai preventivi che la mostrano.
model BouquetPhoto {
  id              String       @id @default(uuid(7)) @db.Uuid
  tenantId        String       @db.Uuid
  configurationId String       @db.Uuid
  storageKey      String
  thumbKey        String
  contentType     String
  width           Int
  height          Int
  sizeBytes       Int
  status          RecordStatus @default(ACTIVE)
  archivedAt      DateTime?
  createdById     String       @db.Uuid
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  tenant        Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  configuration BouquetConfiguration @relation(fields: [tenantId, configurationId], references: [tenantId, id], onDelete: Cascade)
  quoteLines    QuoteLine[]
  orderLines    OrderLine[]

  @@unique([tenantId, id])
  @@index([tenantId, configurationId, status])
}

model BouquetConfigurationLine {
  id              String      @id @default(uuid(7)) @db.Uuid
  tenantId        String      @db.Uuid
  configurationId String      @db.Uuid
  catalogItemId   String      @db.Uuid
  role            BuilderRole
  quantity        Int
  /// Colore scelto per carta, vaso o nastro (uno dei colori dell'articolo); null per fiori
  /// e follaje o articoli senza colori (ADR-030).
  color           String?
  /// Prezzo e costo unitari al salvataggio (snapshot).
  unitPriceMinor  Int
  unitCostMinor   Int?
  lineTotalMinor  Int
  sortOrder       Int         @default(0)
  createdAt       DateTime    @default(now())

  tenant        Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  configuration BouquetConfiguration @relation(fields: [tenantId, configurationId], references: [tenantId, id], onDelete: Cascade)
  catalogItem   CatalogItem          @relation(fields: [tenantId, catalogItemId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@unique([tenantId, configurationId, catalogItemId])
  @@index([tenantId, catalogItemId])
}

// -----------------------------------------------------------------------------
// Foto del catalogo e "Mis ramos" (ADR-029)
// -----------------------------------------------------------------------------

enum CatalogPhotoView {
  FRONT
  SIDE
  TOP
  DETAIL
}

/// Scontorno automatico di una foto del catalogo (ADR-033).
enum CutoutStatus {
  PENDING
  READY
  FAILED
}

/// Foto di un articolo del catalogo (fiori da più angolazioni; carte e nastri per colore).
/// I file stanno nell'archivio (R2) sotto `tenants/{tenantId}/catalog-photos/`, mai pubblici.
model CatalogItemPhoto {
  id            String           @id @default(uuid(7)) @db.Uuid
  tenantId      String           @db.Uuid
  catalogItemId String           @db.Uuid
  view          CatalogPhotoView @default(FRONT)
  /// Uno dei colori dell'articolo (CATALOG_COLORS), o null se la foto non è per un colore.
  color         String?
  storageKey    String
  thumbKey      String
  contentType   String
  width         Int
  height        Int
  sizeBytes     Int
  sortOrder     Int              @default(0)
  /// Versione senza fondo (PNG trasparente) per la composizione del ramo; null se non chiesta.
  cutoutStatus  CutoutStatus?
  cutoutKey     String?
  /// Motivo di un fallimento (codice, es. `cutout_nothing_kept`), mai testo dell'utente.
  cutoutError   String?
  status        RecordStatus     @default(ACTIVE)
  archivedAt    DateTime?
  createdById   String           @db.Uuid
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  catalogItem CatalogItem @relation(fields: [tenantId, catalogItemId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, id])
  @@index([tenantId, catalogItemId, status, sortOrder])
}

/// Foto di un ramo fatto dalla fioreria ("Mis ramos"): riferimento di stile per le anteprime
/// AI, caricata solo con consenso esplicito (chi e quando). Mai usata per addestrare modelli.
model StyleReferencePhoto {
  id                  String        @id @default(uuid(7)) @db.Uuid
  tenantId            String        @db.Uuid
  style               BouquetStyle?
  caption             String?
  storageKey          String
  thumbKey            String
  contentType         String
  width               Int
  height              Int
  sizeBytes           Int
  consentAt           DateTime
  consentById         String        @db.Uuid
  /// Stile fotografico descritto a parole da un modello di visione (inglese, per il prompt) e
  /// in spagnolo per il fiorista; generato una volta alla prima anteprima che lo usa (ADR-032).
  styleDescription    String?
  styleDescriptionEs  String?
  styleDescribedAt    DateTime?
  styleDescriberModel String?
  status              RecordStatus  @default(ACTIVE)
  archivedAt          DateTime?
  createdById         String        @db.Uuid
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, id])
  @@index([tenantId, status, createdAt])
}

// =============================================================================
// Ordini, pagamenti registrati e consegne [ORD-01] (ADR-054, docs/ORDERS_MARKETPLACE_PLAN.md)
// =============================================================================

enum OrderStatus {
  /// Ordine diretto in composizione: righe, consegna e tarjeta prima della conferma (A1b).
  DRAFT
  /// Ordine del marketplace in attesa che la fioreria lo accetti (D-26; arriva con il blocco C4).
  PENDING_ACCEPTANCE
  CONFIRMED
  IN_PREPARATION
  READY
  OUT_FOR_DELIVERY
  DELIVERED
  PICKED_UP
  CANCELLED
}

enum FulfillmentMode {
  DELIVERY
  PICKUP
}

enum OrderPaymentStatus {
  UNPAID
  PARTIAL
  PAID
}

/// Pagamento ricevuto dalla fioreria e registrato a mano (D-26: nessun pagamento online nella V1).
enum PaymentMethod {
  CASH
  TRANSFER
  CARD_TERMINAL
  PAYMENT_LINK
  OTHER
}

enum OrderPaymentKind {
  DEPOSIT
  BALANCE
  /// Storno di un pagamento registrato per errore: importo negativo, nessuna cancellazione.
  REVERSAL
}

model Order {
  id                     String             @id @default(uuid(7)) @db.Uuid
  tenantId               String             @db.Uuid
  /// Numero progressivo per tenant (PED-0001), assegnato dal servizio.
  number                 Int
  customerId             String             @db.Uuid
  /// Preventivo da cui è nato l'ordine (al massimo un ordine per preventivo).
  quoteId                String?            @db.Uuid
  status                 OrderStatus        @default(CONFIRMED)
  statusChangedAt        DateTime           @default(now())
  currency               String             @db.Char(3)
  fulfillmentMode        FulfillmentMode
  /// Giorno di consegna o ritiro, nel calendario del tenant (NULL solo per i borradores).
  scheduledDate          DateTime?          @db.Date
  /// Fascia oraria in minuti dalla mezzanotte (fuso del tenant); entrambi NULL = in giornata.
  windowStartMinutes     Int?
  windowEndMinutes       Int?
  /// Indirizzo del cliente da cui è stato copiato quello di consegna (facoltativo).
  customerAddressId      String?            @db.Uuid
  /// Indirizzo di consegna COPIATO nell'ordine: cambiare la rubrica non cambia gli ordini.
  deliveryAddressLine1   String?
  deliveryAddressLine2   String?
  deliveryNeighborhood   String?
  deliveryCity           String?
  deliveryRegion         String?
  deliveryPostalCode     String?
  deliveryCountryCode    String?            @db.Char(2)
  /// Google Places (ADR-059): ID del luogo (si conserva) e coordinate, cache di 30 giorni.
  deliveryPlaceId        String?
  deliveryLatitude       Float?
  deliveryLongitude      Float?
  deliveryCoordinatesAt  DateTime?
  /// Referencias / entre calles / istruzioni per chi consegna ("llamar antes", "es sorpresa").
  deliveryNotes          String?
  recipientName          String?
  /// Formato E.164.
  recipientPhone         String?
  /// Tarjeta: messaggio per chi riceve il ramo.
  cardMessage            String?
  cardSignature          String?
  cardAnonymous          Boolean            @default(false)
  /// Note interne della fioreria.
  notes                  String?
  subtotalMinor          Int
  discountMinor          Int                @default(0)
  deliveryFeeMinor       Int                @default(0)
  taxMinor               Int                @default(0)
  totalMinor             Int
  /// Somma dei pagamenti registrati (storni compresi), mantenuta dal servizio.
  paidMinor              Int                @default(0)
  paymentStatus          OrderPaymentStatus @default(UNPAID)
  acquisitionSource      AcquisitionSource  @default(MERCHANT_DIRECT)
  cancelReason           String?
  /// Chi porta l'ordine (repartidor): un membro della fioreria, ADR-058.
  assignedMembershipId   String?            @db.Uuid
  /// Chi ha ricevuto il ramo alla consegna o al ritiro (prova di consegna, ADR-058).
  handoverName           String?
  /// Ordine fatto da chi compra dalla pagina pubblica della fioreria (ADR-067).
  placedOnline           Boolean            @default(false)
  /// Chi l'ha fatto (conto cliente del marketplace); NULL se ha cancellato il conto.
  buyerUserId            String?            @db.Uuid
  /// Commenti di chi compra per la fioreria ("colores pastel", "sin lirios").
  buyerNotes             String?
  /// Registro d'inventario con cui si sono scaricati i materiali quando l'ordine è diventato
  /// "Listo" (ADR-071); NULL finché non si scarica (o se niente si controlla).
  inventoryEntryId       String?            @db.Uuid
  /// Apartado con i materiali dell'ordine confermato (ADR-072): lo tiene allineato il servizio degli
  /// ordini, si usa a "Listo" e si libera all'annullamento. L'ultimo, anche se ormai chiuso.
  inventoryReservationId String?            @db.Uuid
  createdById            String?            @db.Uuid
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  tenant               Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer             Customer              @relation(fields: [tenantId, customerId], references: [tenantId, id], onDelete: Restrict)
  quote                Quote?                @relation(fields: [tenantId, quoteId], references: [tenantId, id], onDelete: Restrict)
  assignedTo           Membership?           @relation(fields: [tenantId, assignedMembershipId], references: [tenantId, id], onDelete: Restrict)
  customerAddress      CustomerAddress?      @relation(fields: [tenantId, customerAddressId], references: [tenantId, id], onDelete: Restrict)
  inventoryEntry       InventoryEntry?       @relation(fields: [tenantId, inventoryEntryId], references: [tenantId, id], onDelete: Restrict)
  inventoryReservation InventoryReservation? @relation(fields: [tenantId, inventoryReservationId], references: [tenantId, id], onDelete: Restrict)
  lines                OrderLine[]
  payments             OrderPayment[]
  events               OrderStatusEvent[]
  publicLinks          PublicLink[]
  photos               OrderPhoto[]

  buyer User? @relation("BuyerOrders", fields: [buyerUserId], references: [id], onDelete: SetNull)

  @@unique([tenantId, id])
  @@unique([tenantId, number])
  @@unique([tenantId, quoteId])
  @@unique([tenantId, inventoryEntryId])
  @@unique([tenantId, inventoryReservationId])
  @@index([buyerUserId])
  @@index([tenantId, status])
  @@index([tenantId, scheduledDate])
  @@index([tenantId, customerId])
  @@index([tenantId, assignedMembershipId])
}

/// Righe dell'ordine: stesse regole e snapshot delle righe del preventivo (`QuoteLineKind`).
model OrderLine {
  id                     String        @id @default(uuid(7)) @db.Uuid
  tenantId               String        @db.Uuid
  orderId                String        @db.Uuid
  kind                   QuoteLineKind @default(CATALOG_ITEM)
  catalogItemId          String?       @db.Uuid
  bouquetConfigurationId String?       @db.Uuid
  description            String
  quantity               Int
  unitPriceMinor         Int
  unitCostMinor          Int?
  lineTotalMinor         Int
  snapshot               Json?
  previewJobId           String?       @db.Uuid
  /// Foto vera del ramo (ADR-052), copiata dalla riga del preventivo: ha la precedenza sull'AI.
  bouquetPhotoId         String?       @db.Uuid
  sortOrder              Int           @default(0)
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt

  tenant               Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order                Order                 @relation(fields: [tenantId, orderId], references: [tenantId, id], onDelete: Cascade)
  catalogItem          CatalogItem?          @relation(fields: [tenantId, catalogItemId], references: [tenantId, id], onDelete: Restrict)
  bouquetConfiguration BouquetConfiguration? @relation(fields: [tenantId, bouquetConfigurationId], references: [tenantId, id], onDelete: Restrict)
  previewJob           AiJob?                @relation(fields: [tenantId, previewJobId], references: [tenantId, id], onDelete: Restrict)
  bouquetPhoto         BouquetPhoto?         @relation(fields: [tenantId, bouquetPhotoId], references: [tenantId, id], onDelete: Restrict)

  @@index([tenantId, orderId])
  @@index([tenantId, bouquetConfigurationId])
  @@index([tenantId, previewJobId])
  @@index([tenantId, bouquetPhotoId])
}

model OrderPayment {
  id                String           @id @default(uuid(7)) @db.Uuid
  tenantId          String           @db.Uuid
  orderId           String           @db.Uuid
  kind              OrderPaymentKind
  method            PaymentMethod
  /// Positivo per acconti e saldi, negativo per gli storni.
  amountMinor       Int
  /// Giorno del pagamento, nel calendario del tenant.
  paidOn            DateTime         @db.Date
  reference         String?
  /// Solo per gli storni: il pagamento stornato (uno storno per pagamento).
  reversedPaymentId String?          @db.Uuid
  createdById       String?          @db.Uuid
  createdAt         DateTime         @default(now())

  tenant          Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order           Order         @relation(fields: [tenantId, orderId], references: [tenantId, id], onDelete: Cascade)
  reversedPayment OrderPayment? @relation("PaymentReversal", fields: [tenantId, reversedPaymentId], references: [tenantId, id], onDelete: Restrict)
  reversal        OrderPayment? @relation("PaymentReversal")

  @@unique([tenantId, id])
  @@unique([tenantId, reversedPaymentId])
  @@index([tenantId, orderId])
}

/// Cronologia degli stati dell'ordine (chi, quando, da dove a dove).
model OrderStatusEvent {
  id          String       @id @default(uuid(7)) @db.Uuid
  tenantId    String       @db.Uuid
  orderId     String       @db.Uuid
  /// NULL per l'evento di creazione.
  fromStatus  OrderStatus?
  toStatus    OrderStatus
  note        String?
  createdById String?      @db.Uuid
  createdAt   DateTime     @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order  Order  @relation(fields: [tenantId, orderId], references: [tenantId, id], onDelete: Cascade)

  @@index([tenantId, orderId, createdAt])
}

/// Fascia oraria di consegna o ritiro proposta nei form degli ordini (ADR-055). Configurazione,
/// non dato commerciale: ogni ordine copia i propri minuti, quindi togliere una fascia non cambia
/// gli ordini già fatti.
/// Costo di consegna per distanza (ADR-069): "fino a N metri in linea retta dalla tienda costa X".
/// Configurazione, non dato commerciale: ogni ordine copia il proprio costo.
model DeliveryFeeTier {
  id        String   @id @default(uuid(7)) @db.Uuid
  tenantId  String   @db.Uuid
  maxMeters Int
  feeMinor  Int
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, id])
  @@unique([tenantId, maxMeters])
  @@index([tenantId])
}

model DeliveryWindow {
  id           String   @id @default(uuid(7)) @db.Uuid
  tenantId     String   @db.Uuid
  /// Minuti dalla mezzanotte nel fuso della fioreria.
  startMinutes Int
  endMinutes   Int
  createdAt    DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, id])
  @@unique([tenantId, startMinutes, endMinutes])
  @@index([tenantId])
}

/// Che cosa mostra un link pubblico (ADR-056).
enum PublicLinkKind {
  QUOTE
  ORDER
  /// Resoconto di una visita di Floral Care (ADR-078).
  CARE_VISIT
}

/// Link pubblico di un preventivo (con accettazione), di un ordine (stato) o del resoconto di una
/// visita di Floral Care, da mandare al cliente (ADR-056, ADR-078). Il token non si salva: è
/// firmato dal server (fioreria + ID del link), quindi il fiorista può ricopiarlo quando vuole.
/// Scade e si può disattivare; uno solo attivo per documento.
model PublicLink {
  id          String         @id @default(uuid(7)) @db.Uuid
  tenantId    String         @db.Uuid
  kind        PublicLinkKind
  quoteId     String?        @db.Uuid
  orderId     String?        @db.Uuid
  careVisitId String?        @db.Uuid
  createdById String?        @db.Uuid
  createdAt   DateTime       @default(now())
  expiresAt   DateTime
  revokedAt   DateTime?

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  quote     Quote?     @relation(fields: [tenantId, quoteId], references: [tenantId, id], onDelete: Restrict)
  order     Order?     @relation(fields: [tenantId, orderId], references: [tenantId, id], onDelete: Restrict)
  careVisit CareVisit? @relation(fields: [tenantId, careVisitId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@index([tenantId, quoteId])
  @@index([tenantId, orderId])
  @@index([tenantId, careVisitId])
}

/// Foto del ramo finito di un ordine (prova di consegna, ADR-058): la scatta chi lo prepara o lo
/// consegna, la vede la fioreria e il cliente dal suo link. Una sola attiva per ordine; cambiandola,
/// la precedente si archivia. File privati sotto `tenants/{tenantId}/order-photos/`.
model OrderPhoto {
  id          String       @id @default(uuid(7)) @db.Uuid
  tenantId    String       @db.Uuid
  orderId     String       @db.Uuid
  storageKey  String
  thumbKey    String
  contentType String
  width       Int
  height      Int
  sizeBytes   Int
  status      RecordStatus @default(ACTIVE)
  archivedAt  DateTime?
  createdById String       @db.Uuid
  createdAt   DateTime     @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order  Order  @relation(fields: [tenantId, orderId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@index([tenantId, orderId, status])
}

// -----------------------------------------------------------------------------
// Floral Care e suscripciones dei clienti (ADR-075)
// -----------------------------------------------------------------------------

enum CareFrequency {
  MONTHLY_1
  MONTHLY_2
  WEEKLY
}

enum CareMissedVisitPolicy {
  COUNTS
  RECOVER
}

enum CareDeadPlantPolicy {
  INCLUDED
  QUOTE
}

enum CareServicePricing {
  INCLUDED
  EXTRA
}

enum CareServiceUnit {
  PER_VISIT
  PER_PLANT
  ONE_TIME
}

enum PlantSize {
  SMALL
  MEDIUM
  LARGE
}

enum PlantLight {
  LOW
  MEDIUM
  HIGH
}

/// Tipo di suscripción: cura delle piante (visite) o consegne periodiche (ordini, dopo).
enum CustomerSubscriptionKind {
  CARE
  DELIVERY
}

/// Stato di un contratto con un cliente. Diverso da `SubscriptionStatus`, che è l'abbonamento della
/// fioreria a Gardelia.
enum CustomerSubscriptionStatus {
  DRAFT
  ACTIVE
  PAUSED
  ENDED
  CANCELLED
}

enum CareVisitStatus {
  SCHEDULED
  IN_PROGRESS
  DONE
  NOT_DONE
  CANCELLED
  TO_RESCHEDULE
}

/// Perché una visita è cancellata: cambio di calendario o fine del contratto (sostituita o non più
/// dovuta), la fioreria non può andare, il cliente l'ha chiesta.
enum CareVisitCancelReason {
  SCHEDULE_CHANGE
  CONTRACT_END
  SHOP
  CUSTOMER
}

/// Stato di una pianta alla visita dal telefono (ADR-078).
enum CarePlantCondition {
  OK
  ATTENTION
  PROBLEM
  DEAD
}

/// Un servizio della checklist: fatto o no.
enum CareServiceOutcome {
  DONE
  SKIPPED
}

/// Avviso della squadra per chi gestisce: una pianta da reponer, un lavoro extra chiesto, altro.
enum CareFollowUpKind {
  REPLACEMENT
  EXTRA
  OTHER
}

enum CareFollowUpStatus {
  OPEN
  RESOLVED
}

/// Come si è risolto un avviso (ADR-078, blocco 2b). HANDLED è anche l'"Atendido" del blocco 2a.
enum CareFollowUpResolution {
  HANDLED
  FREE_VISIT
  NEXT_VISIT
  QUOTED
  NOT_REPLACED
}

/// Perché si fa una visita extra (ADR-078, blocco 2b).
enum CareExtraKind {
  EXTRA
  REPLACEMENT
  SEASONAL_INSTALL
  SEASONAL_PICKUP
}

/// Quanto costa una visita extra: la tariffa per visita del contratto, niente, o nella cotización.
enum CareExtraFee {
  VISIT_FEE
  FREE
  QUOTE
}

/// Email di Floral Care al cliente (tabella d'uscita).
enum CareEmailKind {
  VISIT_REPORT
  /// Blocco 4 (ADR-083): le visite spostate o cancellate da un blocco di giorni.
  BLOCK_NOTICE
}

enum CareEmailStatus {
  PENDING
  SENDING
  SENT
  FAILED
}

/// "No se pudo" (ADR-082): il cliente non ha aperto (si paga) o la fioreria non è potuta andare
/// (credito).
enum CareNotDoneCause {
  CUSTOMER
  SHOP
}

/// Le righe di un cargo (ADR-082).
enum CareChargeLineKind {
  VISITS
  VISIT_DEBIT
  VISIT_CREDIT
  EXTRA_VISIT
  ONE_TIME_SERVICE
  CREDIT_CARRIED_IN
  CREDIT_CARRIED_OUT
  ADJUSTMENT
}

/// Perché una visita cobrada torna come credito.
enum CareCreditReason {
  TO_RESCHEDULE
  SHOP
  SCHEDULE_CHANGE
  CONTRACT_END
  NOT_DONE
  /// Il cliente l'ha cancellata in tempo (ADR-082).
  CUSTOMER
}

/// Movimento di soldi del cliente: pagamento, storno ("Anular") o devolución.
enum CarePaymentKind {
  PAYMENT
  REVERSAL
  REFUND
}

/// Un incasso segnato dallo staff alla visita resta "Por registrar" (PENDING) finché chi gestisce
/// lo conferma o lo rifiuta (blocco 3b).
enum CarePaymentStatus {
  RECORDED
  PENDING
  REJECTED
}

/// Offerta di Floral Care della fioreria: una riga per fioreria, creata la prima volta che la
/// salva. I prezzi sono in unità minime nella valuta della fioreria.
model CareSettings {
  tenantId           String                @id @db.Uuid
  visitFeeMinor      Int
  careFeeSmallMinor  Int                   @default(0)
  careFeeMediumMinor Int                   @default(0)
  careFeeLargeMinor  Int                   @default(0)
  frequencies        CareFrequency[]
  /// Raggio in km dal negozio; NULL = senza limite.
  maxDistanceKm      Int?
  minNoticeHours     Int                   @default(24)
  missedVisitPolicy  CareMissedVisitPolicy @default(COUNTS)
  deadPlantPolicy    CareDeadPlantPolicy   @default(QUOTE)
  /// "Días para pagar" un cargo (ADR-082), da 1 a 90.
  paymentDueDays     Int                   @default(10)
  /// Cancelación del cliente (ADR-082): si paga con meno di queste ore di preavviso; 0 = mai.
  lateCancelHours    Int                   @default(12)
  /// Termini della fioreria, scritti da lei (Gardelia non inventa condizioni).
  termsText          String?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

/// Sovrapprezzo per uscita secondo la distanza in linea retta dal negozio.
model CareTravelTier {
  id        String   @id @default(uuid(7)) @db.Uuid
  tenantId  String   @db.Uuid
  maxMeters Int
  feeMinor  Int
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, id])
  @@unique([tenantId, maxMeters])
  @@index([tenantId])
}

/// Servizio di Floral Care: della lista nostra (`presetKey`) o scritto dal fiorista.
model CareService {
  id          String             @id @default(uuid(7)) @db.Uuid
  tenantId    String             @db.Uuid
  presetKey   String?
  name        String
  description String?
  pricing     CareServicePricing
  unit        CareServiceUnit    @default(PER_VISIT)
  /// 0 per i servizi inclusi nella tariffa per uscita.
  priceMinor  Int                @default(0)
  status      RecordStatus       @default(ACTIVE)
  sortOrder   Int                @default(0)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  tenant        Tenant                        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  subscriptions CustomerSubscriptionService[]
  visitResults  CareVisitServiceResult[]
  chargeLines   CareChargeLine[]

  @@unique([tenantId, id])
  @@unique([tenantId, presetKey])
  @@index([tenantId, status])
}

/// Fascia di uscita: un giorno della settimana, da–a (minuti nel fuso della fioreria) e quante
/// visite ci stanno. Si archivia, non si cancella: le visite passate la citano.
model CareSlot {
  id           String       @id @default(uuid(7)) @db.Uuid
  tenantId     String       @db.Uuid
  /// 0 = domenica … 6 = sabato.
  weekday      Int
  startMinutes Int
  endMinutes   Int
  capacity     Int
  status       RecordStatus @default(ACTIVE)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  tenant        Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  subscriptions CustomerSubscriptionSlot[]
  visits        CareVisit[]
  blocks        CareBlock[]

  @@unique([tenantId, id])
  @@index([tenantId, weekday])
}

/// Suscripción di un cliente: per ora contratti di Floral Care (`CARE`). Il prezzo è copiato alla
/// conferma (versione del prezzo); le visite seguono la versione del calendario.
model CustomerSubscription {
  id                   String                     @id @default(uuid(7)) @db.Uuid
  tenantId             String                     @db.Uuid
  /// Numero progressivo per tenant (SUS-0001).
  number               Int
  customerId           String                     @db.Uuid
  kind                 CustomerSubscriptionKind
  status               CustomerSubscriptionStatus @default(DRAFT)
  /// Sede del contratto (indirizzo del cliente).
  customerAddressId    String?                    @db.Uuid
  frequency            CareFrequency?
  /// Posti che occupa ogni visita in una fascia (un contratto grande ne prende più d'uno).
  seats                Int                        @default(1)
  startDate            DateTime                   @db.Date
  endDate              DateTime?                  @db.Date
  scheduleVersion      Int                        @default(1)
  priceVersion         Int                        @default(1)
  currency             String
  visitFeeMinor        Int                        @default(0)
  careFeeSmallMinor    Int                        @default(0)
  careFeeMediumMinor   Int                        @default(0)
  careFeeLargeMinor    Int                        @default(0)
  travelSurchargeMinor Int                        @default(0)
  /// Totale di una visita e degli extra una tantum, calcolati dal server alla conferma.
  perVisitMinor        Int                        @default(0)
  oneTimeMinor         Int                        @default(0)
  /// Distanza dal negozio salvata alla conferma (le coordinate del cliente scadono dopo 30 giorni).
  distanceMeters       Int?
  outOfRange           Boolean                    @default(false)
  contactName          String?
  contactPhone         String?
  accessNotes          String?
  notes                String?
  /// Fin dove sono state create le visite (calendario della fioreria).
  generatedUntil       DateTime?                  @db.Date
  /// L'ultimo mese con il cargo già emesso (primo giorno del mese); NULL = mai (ADR-082).
  chargedThrough       DateTime?                  @db.Date
  /// Regole della fioreria copiate alla conferma (ADR-082): valgono per tutto il contratto.
  missedVisitPolicy    CareMissedVisitPolicy?
  deadPlantPolicy      CareDeadPlantPolicy?
  /// Ore di preavviso per cancellare senza pagare, copiate alla conferma (ADR-082).
  lateCancelHours      Int?
  /// Ore di preavviso per cambiare la data dal portale, copiate alla conferma (ADR-084).
  minNoticeHours       Int?
  acquisitionSource    AcquisitionSource          @default(MERCHANT_DIRECT)
  /// Chi ha confermato il contratto: da lui viene il permesso dei lavori automatici.
  confirmedById        String?                    @db.Uuid
  confirmedAt          DateTime?
  endedAt              DateTime?
  createdById          String?                    @db.Uuid
  createdAt            DateTime                   @default(now())
  updatedAt            DateTime                   @updatedAt

  tenant          Tenant                        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer        Customer                      @relation(fields: [tenantId, customerId], references: [tenantId, id], onDelete: Restrict)
  customerAddress CustomerAddress?              @relation(fields: [tenantId, customerAddressId], references: [tenantId, id], onDelete: Restrict)
  slots           CustomerSubscriptionSlot[]
  services        CustomerSubscriptionService[]
  plants          CarePlant[]
  visits          CareVisit[]
  photos          CarePhoto[]
  followUps       CareFollowUp[]
  emails          CareEmail[]
  quotes          Quote[]
  charges         CareCharge[]
  adjustments     CareChargeAdjustment[]
  blockChanges    CareBlockVisit[]
  portalInvites   CarePortalInvite[]
  portalAccess    CarePortalAccess[]

  @@unique([tenantId, id])
  /// Per le FK dei cargos: il cargo è dello stesso cliente del contratto.
  @@unique([tenantId, id, customerId])
  @@unique([tenantId, number])
  @@index([tenantId, status])
  @@index([tenantId, customerId])
}

/// Le fasce scelte per il calendario del contratto (una per le mensili, una per giorno per quella
/// settimanale).
model CustomerSubscriptionSlot {
  id             String   @id @default(uuid(7)) @db.Uuid
  tenantId       String   @db.Uuid
  subscriptionId String   @db.Uuid
  slotId         String   @db.Uuid
  createdAt      DateTime @default(now())

  tenant       Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  subscription CustomerSubscription @relation(fields: [tenantId, subscriptionId], references: [tenantId, id], onDelete: Restrict)
  slot         CareSlot             @relation(fields: [tenantId, slotId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@unique([tenantId, subscriptionId, slotId])
  @@index([tenantId, slotId])
}

/// Servizi del contratto, con nome e prezzo copiati.
model CustomerSubscriptionService {
  id             String             @id @default(uuid(7)) @db.Uuid
  tenantId       String             @db.Uuid
  subscriptionId String             @db.Uuid
  serviceId      String             @db.Uuid
  name           String
  pricing        CareServicePricing
  unit           CareServiceUnit
  priceMinor     Int
  createdAt      DateTime           @default(now())

  tenant       Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  subscription CustomerSubscription @relation(fields: [tenantId, subscriptionId], references: [tenantId, id], onDelete: Restrict)
  service      CareService          @relation(fields: [tenantId, serviceId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@unique([tenantId, subscriptionId, serviceId])
}

/// Piante della sede del contratto (anche a gruppi: "12 potos en jardinera").
model CarePlant {
  id                String       @id @default(uuid(7)) @db.Uuid
  tenantId          String       @db.Uuid
  subscriptionId    String       @db.Uuid
  name              String
  canonicalFlowerId String?      @db.Uuid
  quantity          Int
  size              PlantSize
  location          String?
  light             PlantLight?
  watering          String?
  /// Istruzioni per chi sta sul posto (le vede il cliente).
  instructions      String?
  /// Pianta del cambio di stagione (ADR-078): fuori dal prezzo del contratto, archiviata al ritiro.
  seasonal          Boolean      @default(false)
  status            RecordStatus @default(ACTIVE)
  sortOrder         Int          @default(0)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  tenant       Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  subscription CustomerSubscription   @relation(fields: [tenantId, subscriptionId], references: [tenantId, id], onDelete: Restrict)
  species      CanonicalFlower?       @relation(fields: [canonicalFlowerId], references: [id], onDelete: Restrict)
  visitResults CareVisitPlantResult[]
  photos       CarePhoto[]
  followUps    CareFollowUp[]

  @@unique([tenantId, id])
  @@index([tenantId, subscriptionId])
}

/// Visita di Floral Care. Unica per contratto, versione del calendario e data originale (indice
/// parziale nel SQL, salvo le visite extra); le cancellate restano come righe.
model CareVisit {
  id                   String                 @id @default(uuid(7)) @db.Uuid
  tenantId             String                 @db.Uuid
  subscriptionId       String                 @db.Uuid
  scheduleVersion      Int
  originalDate         DateTime               @db.Date
  /// NULL solo per "Por reprogramar" (o una visita così cancellata).
  scheduledDate        DateTime?              @db.Date
  slotId               String?                @db.Uuid
  startMinutes         Int?
  endMinutes           Int?
  seats                Int                    @default(1)
  status               CareVisitStatus        @default(SCHEDULED)
  isExtra              Boolean                @default(false)
  assignedMembershipId String?                @db.Uuid
  startedAt            DateTime?
  /// Chi ha iniziato la visita dal telefono ("Empezar visita", ADR-078).
  startedById          String?                @db.Uuid
  finishedAt           DateTime?
  /// Perché si è cancellata: serve ai cargos (una visita tolta dalla fioreria è un credito).
  cancelReason         CareVisitCancelReason?
  /// Cancellata dal cliente: true se si paga (meno preavviso del limite del contratto, ADR-082).
  cancelCharged        Boolean?
  /// "No se pudo": il cliente non ha aperto o la fioreria non è potuta andare (ADR-082).
  notDoneCause         CareNotDoneCause?
  /// Hecha o no realizada: la nota che il cliente legge nel resoconto. Cancellata: il perché.
  outcomeNote          String?
  closedById           String?                @db.Uuid
  /// Registro d'inventario con i materiali usati, scritto a "Terminar visita" (ADR-078).
  inventoryEntryId     String?                @db.Uuid
  /// Visita extra (ADR-078, blocco 2b): perché, quale costo e quanto (calcolato dal server).
  extraKind            CareExtraKind?
  extraFee             CareExtraFee?
  extraFeeMinor        Int?
  /// Nota della visita extra per chi la fa.
  extraNote            String?
  /// La cotización del contratto che paga questa visita ("en la cotización").
  quoteId              String?                @db.Uuid
  /// Blocco 3b: la visita mancata (cliente) che questa visita extra gratis recupera.
  recoveryOfVisitId    String?                @db.Uuid
  /// Blocco 5a (ADR-084): l'ultima data l'ha scelta il cliente dal portale; la fioreria che la
  /// sposta di nuovo lo azzera.
  customerMovedAt      DateTime?
  createdById          String?                @db.Uuid
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  tenant            Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  subscription      CustomerSubscription     @relation(fields: [tenantId, subscriptionId], references: [tenantId, id], onDelete: Restrict)
  slot              CareSlot?                @relation(fields: [tenantId, slotId], references: [tenantId, id], onDelete: Restrict)
  assignedTo        Membership?              @relation(fields: [tenantId, assignedMembershipId], references: [tenantId, id], onDelete: Restrict)
  inventoryEntry    InventoryEntry?          @relation(fields: [tenantId, inventoryEntryId], references: [tenantId, id], onDelete: Restrict)
  quote             Quote?                   @relation(fields: [tenantId, quoteId], references: [tenantId, id], onDelete: Restrict)
  serviceResults    CareVisitServiceResult[]
  plantResults      CareVisitPlantResult[]
  materials         CareVisitMaterial[]
  photos            CarePhoto[]
  followUps         CareFollowUp[]           @relation("CareFollowUpVisit")
  /// Gli avvisi che questa visita extra ha risolto ("Reposición sin costo").
  resolvedFollowUps CareFollowUp[]           @relation("CareFollowUpExtraVisit")
  emails            CareEmail[]
  publicLinks       PublicLink[]
  /// Quanto è cobrado adesso per questa visita (ADR-082).
  billing           CareVisitBilling?
  chargeLines       CareChargeLine[]
  payments          CarePayment[]
  recoveryOf        CareVisit?               @relation("CareVisitRecovery", fields: [tenantId, subscriptionId, recoveryOfVisitId], references: [tenantId, subscriptionId, id], onDelete: Restrict)
  recoveries        CareVisit[]              @relation("CareVisitRecovery")
  /// Blocco 4 (ADR-083): i blocchi che l'hanno spostata o cancellata.
  blockChanges      CareBlockVisit[]

  @@unique([tenantId, id])
  /// Per la FK della visita di recupero: è dello stesso contratto della visita mancata.
  @@unique([tenantId, subscriptionId, id])
  @@unique([tenantId, inventoryEntryId])
  @@index([tenantId, quoteId])
  @@index([tenantId, recoveryOfVisitId])
  @@index([tenantId, scheduledDate])
  @@index([tenantId, slotId, scheduledDate])
  @@index([tenantId, subscriptionId])
}

/// Un servizio della checklist di una visita (ADR-078). Punta al servizio della fioreria, che non si
/// cancella mai (quelli del contratto sì, a ogni modifica), e ne copia nome, prezzo e unità: il
/// resoconto resta com'era anche se poi il servizio cambia.
model CareVisitServiceResult {
  id           String             @id @default(uuid(7)) @db.Uuid
  tenantId     String             @db.Uuid
  visitId      String             @db.Uuid
  serviceId    String             @db.Uuid
  name         String
  pricing      CareServicePricing
  unit         CareServiceUnit
  outcome      CareServiceOutcome
  /// Prezzo del servizio nel contratto quando la squadra l'ha segnato: un servizio "una sola vez"
  /// si cobra a questo prezzo (ADR-082).
  priceMinor   Int?
  note         String?
  recordedById String?            @db.Uuid
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  visit       CareVisit        @relation(fields: [tenantId, visitId], references: [tenantId, id], onDelete: Restrict)
  service     CareService      @relation(fields: [tenantId, serviceId], references: [tenantId, id], onDelete: Restrict)
  chargeLines CareChargeLine[]

  @@unique([tenantId, id])
  @@unique([tenantId, visitId, serviceId])
}

/// Lo stato di una pianta (o di un gruppo) alla visita. Nome e quantità copiati: il resoconto
/// resta com'era. `affected`: in un gruppo, quante piante sono toccate.
model CareVisitPlantResult {
  id           String             @id @default(uuid(7)) @db.Uuid
  tenantId     String             @db.Uuid
  visitId      String             @db.Uuid
  plantId      String             @db.Uuid
  plantName    String
  quantity     Int
  condition    CarePlantCondition
  affected     Int?
  note         String?
  recordedById String?            @db.Uuid
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  tenant Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  visit  CareVisit @relation(fields: [tenantId, visitId], references: [tenantId, id], onDelete: Restrict)
  plant  CarePlant @relation(fields: [tenantId, plantId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@unique([tenantId, visitId, plantId])
  @@index([tenantId, plantId])
}

/// Materiali segnati durante la visita: escono dall'inventario tutti insieme a "Terminar visita".
model CareVisitMaterial {
  id            String   @id @default(uuid(7)) @db.Uuid
  tenantId      String   @db.Uuid
  visitId       String   @db.Uuid
  catalogItemId String   @db.Uuid
  quantity      Int
  createdById   String?  @db.Uuid
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  visit       CareVisit   @relation(fields: [tenantId, visitId], references: [tenantId, id], onDelete: Restrict)
  catalogItem CatalogItem @relation(fields: [tenantId, catalogItemId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@unique([tenantId, visitId, catalogItemId])
}

/// Foto di una visita (ADR-078), file privati sotto `tenants/{tenantId}/care-photos/`. Si cancellano
/// da R2 30 giorni dopo la fine del contratto, o subito se tolte (eccezione voluta dal founder): la
/// riga resta con `deletedAt`. `uploadKey`: un nuovo tentativo dello stesso file non la raddoppia.
model CarePhoto {
  id             String    @id @default(uuid(7)) @db.Uuid
  tenantId       String    @db.Uuid
  subscriptionId String    @db.Uuid
  visitId        String?   @db.Uuid
  plantId        String?   @db.Uuid
  storageKey     String
  thumbKey       String
  contentType    String
  width          Int
  height         Int
  sizeBytes      Int
  uploadKey      String?   @db.Uuid
  createdById    String?   @db.Uuid
  createdAt      DateTime  @default(now())
  /// Tolta da chi fa o gestisce la visita: non si vede più; i file si cancellano subito.
  removedAt      DateTime?
  removedById    String?   @db.Uuid
  /// I file non ci sono più (tolta, o contratto finito da 30 giorni).
  deletedAt      DateTime?

  tenant       Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  subscription CustomerSubscription @relation(fields: [tenantId, subscriptionId], references: [tenantId, id], onDelete: Restrict)
  visit        CareVisit?           @relation(fields: [tenantId, visitId], references: [tenantId, id], onDelete: Restrict)
  plant        CarePlant?           @relation(fields: [tenantId, plantId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@unique([tenantId, visitId, uploadKey])
  @@index([tenantId, visitId])
}

/// Avviso della squadra per chi gestisce (ADR-078): una pianta morta da reponer (anche creato da
/// solo), un lavoro extra chiesto dal cliente, altro. Non si cancella: si segna come atteso.
model CareFollowUp {
  id             String                  @id @default(uuid(7)) @db.Uuid
  tenantId       String                  @db.Uuid
  subscriptionId String                  @db.Uuid
  visitId        String                  @db.Uuid
  kind           CareFollowUpKind
  plantId        String?                 @db.Uuid
  quantity       Int?
  note           String?
  status         CareFollowUpStatus      @default(OPEN)
  /// Come si è risolto (ADR-078, blocco 2b): solo se RESOLVED.
  resolution     CareFollowUpResolution?
  /// La cotización ("Cotizar") o la visita extra ("Reposición sin costo") che l'hanno risolto.
  quoteId        String?                 @db.Uuid
  extraVisitId   String?                 @db.Uuid
  resolutionNote String?
  resolvedById   String?                 @db.Uuid
  resolvedAt     DateTime?
  createdById    String?                 @db.Uuid
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt

  tenant       Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  subscription CustomerSubscription @relation(fields: [tenantId, subscriptionId], references: [tenantId, id], onDelete: Restrict)
  visit        CareVisit            @relation("CareFollowUpVisit", fields: [tenantId, visitId], references: [tenantId, id], onDelete: Restrict)
  plant        CarePlant?           @relation(fields: [tenantId, plantId], references: [tenantId, id], onDelete: Restrict)
  quote        Quote?               @relation(fields: [tenantId, quoteId], references: [tenantId, id], onDelete: Restrict)
  extraVisit   CareVisit?           @relation("CareFollowUpExtraVisit", fields: [tenantId, extraVisitId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@index([tenantId, status])
  @@index([tenantId, visitId])
}

/// Tabella d'uscita delle email di Floral Care al cliente (ADR-078): una per visita e tipo, così il
/// resoconto parte una volta sola anche con due "Terminar" o con i nuovi tentativi. Non salva
/// l'indirizzo: lo rilegge dal cliente al momento di mandare.
model CareEmail {
  id             String          @id @default(uuid(7)) @db.Uuid
  tenantId       String          @db.Uuid
  kind           CareEmailKind
  subscriptionId String          @db.Uuid
  visitId        String?         @db.Uuid
  /// Blocco 4 (ADR-083): l'avviso dei cambi di un blocco, uno per contratto (senza visita).
  blockId        String?         @db.Uuid
  status         CareEmailStatus @default(PENDING)
  attempts       Int             @default(0)
  sentAt         DateTime?
  /// Codice dell'ultimo errore (mai il testo del provider, che può contenere l'indirizzo).
  lastError      String?
  requestedById  String?         @db.Uuid
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  tenant       Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  subscription CustomerSubscription @relation(fields: [tenantId, subscriptionId], references: [tenantId, id], onDelete: Restrict)
  visit        CareVisit?           @relation(fields: [tenantId, visitId], references: [tenantId, id], onDelete: Restrict)
  block        CareBlock?           @relation(fields: [tenantId, blockId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@unique([tenantId, visitId, kind])
  @@index([tenantId, blockId])
}

/// Cargo del mese di un contratto di Floral Care (ADR-082): nasce dalle visite del mese (più le
/// variazioni dei mesi prima) e poi non cambia. Uno per contratto e mese. Totale, pagato e saldo
/// si controllano nel database; lo stato (vencido, pagado…) si calcola in lettura.
model CareCharge {
  id             String   @id @default(uuid(7)) @db.Uuid
  tenantId       String   @db.Uuid
  /// Numero progressivo per fioreria (CAR-0001).
  number         Int
  subscriptionId String   @db.Uuid
  customerId     String   @db.Uuid
  /// Il mese del cargo (primo giorno), nel calendario della fioreria.
  period         DateTime @db.Date
  issuedOn       DateTime @db.Date
  dueDate        DateTime @db.Date
  currency       String
  /// Prezzo di una visita e versione del prezzo del contratto quando il cargo è nato.
  unitPriceMinor Int
  priceVersion   Int
  /// Visite del mese nella riga VISITS.
  visitCount     Int      @default(0)
  totalMinor     Int
  paidMinor      Int      @default(0)
  /// Totale − pagato: positivo, il cliente deve; negativo, la fioreria deve restituire.
  balanceMinor   Int
  /// Cargo dopo la fine del contratto: può restare a favore del cliente (si chiude con una
  /// devolución). Gli altri non vanno mai sotto zero.
  final          Boolean  @default(false)
  /// Chi l'ha emesso (conferma, cambio di prezzo); NULL = il lavoro giornaliero.
  issuedById     String?  @db.Uuid
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant       Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  subscription CustomerSubscription    @relation(fields: [tenantId, subscriptionId, customerId], references: [tenantId, id, customerId], onDelete: Restrict)
  customer     Customer                @relation(fields: [tenantId, customerId], references: [tenantId, id], onDelete: Restrict)
  lines        CareChargeLine[]        @relation("CareChargeLines")
  /// Le righe che portano il saldo a favore di questo cargo nel cargo dopo.
  carriedInto  CareChargeLine[]        @relation("CareChargeLineSource")
  allocations  CarePaymentAllocation[]

  @@unique([tenantId, id])
  /// Per le FK delle righe (stesso contratto) e delle distribuzioni (stesso cliente).
  @@unique([tenantId, id, subscriptionId])
  @@unique([tenantId, id, customerId])
  @@unique([tenantId, number])
  @@unique([tenantId, subscriptionId, period])
  @@index([tenantId, customerId])
  @@index([tenantId, period])
  @@index([tenantId, dueDate])
}

/// Una riga di un cargo (ADR-082), con il segno: i crediti sono negativi. Le righe di una visita
/// puntano alla visita (e ne copiano il giorno), quella di un servizio "una sola vez" al risultato
/// della visita e al servizio, con il nome copiato.
model CareChargeLine {
  id              String             @id @default(uuid(7)) @db.Uuid
  tenantId        String             @db.Uuid
  chargeId        String             @db.Uuid
  subscriptionId  String             @db.Uuid
  /// Ordine delle righe nel cargo.
  position        Int
  kind            CareChargeLineKind
  visitId         String?            @db.Uuid
  visitDate       DateTime?          @db.Date
  serviceResultId String?            @db.Uuid
  serviceId       String?            @db.Uuid
  /// CREDIT_CARRIED_IN: il cargo da cui viene il saldo a favore.
  sourceChargeId  String?            @db.Uuid
  /// ADJUSTMENT: l'ajuste che la riga porta nel cargo (una volta sola).
  adjustmentId    String?            @db.Uuid
  creditReason    CareCreditReason?
  /// Nome copiato del servizio "una sola vez" o motivo dell'ajuste.
  label           String?
  quantity        Int                @default(1)
  unitPriceMinor  Int
  amountMinor     Int
  createdAt       DateTime           @default(now())

  tenant        Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  charge        CareCharge              @relation("CareChargeLines", fields: [tenantId, chargeId, subscriptionId], references: [tenantId, id, subscriptionId], onDelete: Restrict)
  visit         CareVisit?              @relation(fields: [tenantId, visitId], references: [tenantId, id], onDelete: Restrict)
  serviceResult CareVisitServiceResult? @relation(fields: [tenantId, serviceResultId], references: [tenantId, id], onDelete: Restrict)
  service       CareService?            @relation(fields: [tenantId, serviceId], references: [tenantId, id], onDelete: Restrict)
  sourceCharge  CareCharge?             @relation("CareChargeLineSource", fields: [tenantId, sourceChargeId], references: [tenantId, id], onDelete: Restrict)
  adjustment    CareChargeAdjustment?   @relation(fields: [tenantId, subscriptionId, adjustmentId], references: [tenantId, subscriptionId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@unique([tenantId, chargeId, position])
  @@unique([tenantId, adjustmentId])
  /// Ogni emissione cerca le righe del contratto per tipo (servizi "una sola vez", saldi a favore).
  @@index([tenantId, subscriptionId, kind])
  @@index([tenantId, visitId])
  @@index([tenantId, sourceChargeId])
}

/// "Ajuste para el próximo cargo" (blocco 3b, ADR-082): chi gestisce corregge un errore o fa uno
/// sconto. Entra una volta nel primo cargo che nasce (riga ADJUSTMENT); prima si può togliere.
model CareChargeAdjustment {
  id             String    @id @default(uuid(7)) @db.Uuid
  tenantId       String    @db.Uuid
  subscriptionId String    @db.Uuid
  /// Con il segno: negativo a favore del cliente, positivo a suo carico.
  amountMinor    Int
  currency       String
  /// Il motivo, che diventa l'etichetta della riga del cargo.
  reason         String
  createdById    String?   @db.Uuid
  createdAt      DateTime  @default(now())
  /// "Quitar" prima che entri in un cargo: resta nello storico.
  removedAt      DateTime?
  removedById    String?   @db.Uuid

  tenant       Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  subscription CustomerSubscription @relation(fields: [tenantId, subscriptionId], references: [tenantId, id], onDelete: Restrict)
  lines        CareChargeLine[]

  @@unique([tenantId, id])
  /// Per la FK delle righe: l'ajuste è dello stesso contratto del cargo.
  @@unique([tenantId, subscriptionId, id])
  @@index([tenantId, subscriptionId])
}

/// Blocco 4 (ADR-083): cosa succede alle visite dei giorni bloccati.
enum CareBlockAction {
  /// Al giorno libero più vicino dello stesso mese (senza posto: "Por reprogramar").
  MOVE
  /// Cancellate come se le togliesse la fioreria (credito nel cargo dopo).
  CANCEL
}

/// Cosa è successo a una visita toccata da un blocco.
enum CareBlockOutcome {
  MOVED
  TO_RESCHEDULE
  CANCELLED
}

/// Giorni bloccati di Floral Care (blocco 4, ADR-083): vacanze, giorni di punta, un orario tolto.
/// Lì non si prenota più niente; le visite che nasceranno in quei giorni seguono `action`. Non si
/// cancella: "Quitar" lo segna tolto e le visite già spostate restano dove sono.
model CareBlock {
  id          String          @id @default(uuid(7)) @db.Uuid
  tenantId    String          @db.Uuid
  startDate   DateTime        @db.Date
  endDate     DateTime        @db.Date
  /// NULL = tutte le fasce (anche le visite extra a un'ora libera).
  slotId      String?         @db.Uuid
  /// Il nome che sceglie la fioreria ("Vacaciones"): non lo vedono i clienti.
  label       String
  action      CareBlockAction
  createdById String?         @db.Uuid
  createdAt   DateTime        @default(now())
  removedAt   DateTime?
  removedById String?         @db.Uuid

  tenant  Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  slot    CareSlot?        @relation(fields: [tenantId, slotId], references: [tenantId, id], onDelete: Restrict)
  changes CareBlockVisit[]
  emails  CareEmail[]

  @@unique([tenantId, id])
  @@index([tenantId, endDate])
}

/// Una visita che un blocco ha spostato o cancellato quando è nato: l'elenco dei clienti toccati
/// e il testo dell'email. La visita è dello stesso contratto (FK composita).
model CareBlockVisit {
  id               String           @id @default(uuid(7)) @db.Uuid
  tenantId         String           @db.Uuid
  blockId          String           @db.Uuid
  visitId          String           @db.Uuid
  subscriptionId   String           @db.Uuid
  outcome          CareBlockOutcome
  fromDate         DateTime         @db.Date
  fromStartMinutes Int?
  fromEndMinutes   Int?
  /// Solo per MOVED: il giorno e l'orario nuovi.
  toDate           DateTime?        @db.Date
  toStartMinutes   Int?
  toEndMinutes     Int?
  createdAt        DateTime         @default(now())

  tenant       Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  block        CareBlock            @relation(fields: [tenantId, blockId], references: [tenantId, id], onDelete: Restrict)
  visit        CareVisit            @relation(fields: [tenantId, subscriptionId, visitId], references: [tenantId, subscriptionId, id], onDelete: Restrict)
  subscription CustomerSubscription @relation(fields: [tenantId, subscriptionId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@unique([tenantId, blockId, visitId])
  @@index([tenantId, blockId, subscriptionId])
  @@index([tenantId, subscriptionId, visitId])
}

/// Quanto è cobrado adesso per una visita (ADR-082). La scrive solo l'emissione dei cargos, in una
/// tabella sua: un cargo non aggiorna mai la visita (il cambio di una fascia aggiorna le visite
/// senza bloccare il contratto). `stableAt`: la visita è chiusa e già sistemata, non si guarda più.
model CareVisitBilling {
  id          String    @id @default(uuid(7)) @db.Uuid
  tenantId    String    @db.Uuid
  visitId     String    @db.Uuid
  /// NULL = niente di cobrado per questa visita.
  billedMinor Int?
  stableAt    DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tenant Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  visit  CareVisit @relation(fields: [tenantId, visitId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@unique([tenantId, visitId])
}

/// Un movimento di soldi di un cliente per Floral Care (ADR-082), registrato a mano: pagamento,
/// storno di un movimento sbagliato ("Anular", di segno opposto, uno per movimento) o devolución di
/// un saldo a favore. Si distribuisce sui cargos (`CarePaymentAllocation`). Niente si cancella.
model CarePayment {
  id                String            @id @default(uuid(7)) @db.Uuid
  tenantId          String            @db.Uuid
  customerId        String            @db.Uuid
  kind              CarePaymentKind
  status            CarePaymentStatus @default(RECORDED)
  /// Con il segno: pagamenti positivi, devoluciones negative, storni di segno opposto.
  amountMinor       Int
  /// Blocco 3b: quanto ha segnato chi ha fatto la visita ("Cobré en la visita"). Chi conferma può
  /// registrare meno (amountMinor), mai di più.
  collectedMinor    Int?
  currency          String
  method            PaymentMethod
  /// Giorno del pagamento, nel calendario della fioreria.
  paidOn            DateTime          @db.Date
  reference         String?
  note              String?
  /// "Cobré en la visita" (blocco 3b): la visita in cui lo staff ha incassato.
  visitId           String?           @db.Uuid
  /// Chiave del modulo: lo stesso invio arrivato due volte non raddoppia il pagamento.
  submitKey         String?           @db.Uuid
  /// Solo per gli storni: il movimento annullato.
  reversedPaymentId String?           @db.Uuid
  createdById       String?           @db.Uuid
  reviewedById      String?           @db.Uuid
  reviewedAt        DateTime?
  rejectReason      String?
  createdAt         DateTime          @default(now())

  tenant          Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer        Customer                @relation(fields: [tenantId, customerId], references: [tenantId, id], onDelete: Restrict)
  visit           CareVisit?              @relation(fields: [tenantId, visitId], references: [tenantId, id], onDelete: Restrict)
  reversedPayment CarePayment?            @relation("CarePaymentReversal", fields: [tenantId, reversedPaymentId], references: [tenantId, id], onDelete: Restrict)
  reversal        CarePayment?            @relation("CarePaymentReversal")
  allocations     CarePaymentAllocation[]

  @@unique([tenantId, id])
  /// Per le FK delle distribuzioni: stesso cliente del cargo.
  @@unique([tenantId, id, customerId])
  @@unique([tenantId, reversedPaymentId])
  @@unique([tenantId, submitKey])
  @@index([tenantId, customerId])
  @@index([tenantId, status])
}

/// Quanto di un movimento va su un cargo (ADR-082). Il cliente è nelle due chiavi: un pagamento non
/// tocca mai i cargos di un altro cliente.
model CarePaymentAllocation {
  id          String   @id @default(uuid(7)) @db.Uuid
  tenantId    String   @db.Uuid
  paymentId   String   @db.Uuid
  chargeId    String   @db.Uuid
  customerId  String   @db.Uuid
  amountMinor Int
  createdAt   DateTime @default(now())

  tenant  Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  payment CarePayment @relation(fields: [tenantId, paymentId, customerId], references: [tenantId, id, customerId], onDelete: Restrict)
  charge  CareCharge  @relation(fields: [tenantId, chargeId, customerId], references: [tenantId, id, customerId], onDelete: Restrict)

  @@unique([tenantId, id])
  @@unique([tenantId, paymentId, chargeId])
  @@index([tenantId, chargeId])
}

/// Floral Care, pagina del cliente (ADR-084): l'invito di una persona (email) a vedere i contratti
/// di un cliente, uno solo (`subscriptionId`) o tutti (NULL). Il link è firmato con la fioreria e
/// l'id; vale 7 giorni e solo per la stessa email.
model CarePortalInvite {
  id             String                 @id @default(uuid(7)) @db.Uuid
  tenantId       String                 @db.Uuid
  customerId     String                 @db.Uuid
  subscriptionId String?                @db.Uuid
  /// Minuscola: si confronta con l'email (verificata) di chi accetta.
  email          String
  /// "Puede ver precios y cobros" (deciso dal founder il 24/11).
  canSeeMoney    Boolean                @default(true)
  status         CarePortalInviteStatus @default(PENDING)
  expiresAt      DateTime
  emailSentAt    DateTime?
  createdById    String?                @db.Uuid
  acceptedAt     DateTime?
  acceptedUserId String?                @db.Uuid
  revokedAt      DateTime?
  revokedById    String?                @db.Uuid
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  tenant       Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer     Customer              @relation(fields: [tenantId, customerId], references: [tenantId, id], onDelete: Restrict)
  subscription CustomerSubscription? @relation(fields: [tenantId, subscriptionId, customerId], references: [tenantId, id, customerId], onDelete: Restrict)
  accesses     CarePortalAccess[]

  @@unique([tenantId, id])
  @@unique([tenantId, id, customerId])
  @@index([tenantId, customerId, status])
  @@index([tenantId, subscriptionId])
}

/// Il collegamento cliente ↔ persona nato da un invito: la persona vede i contratti del cliente
/// (uno o tutti). Non si cancella: si chiude (`revokedAt`). Sparisce con il conto della persona.
model CarePortalAccess {
  id             String                  @id @default(uuid(7)) @db.Uuid
  tenantId       String                  @db.Uuid
  customerId     String                  @db.Uuid
  subscriptionId String?                 @db.Uuid
  userId         String                  @db.Uuid
  inviteId       String                  @db.Uuid
  canSeeMoney    Boolean                 @default(true)
  revokedAt      DateTime?
  revokedReason  CarePortalRevokeReason?
  revokedById    String?                 @db.Uuid
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt

  tenant       Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer     Customer              @relation(fields: [tenantId, customerId], references: [tenantId, id], onDelete: Restrict)
  subscription CustomerSubscription? @relation(fields: [tenantId, subscriptionId, customerId], references: [tenantId, id, customerId], onDelete: Restrict)
  invite       CarePortalInvite      @relation(fields: [tenantId, inviteId, customerId], references: [tenantId, id, customerId], onDelete: Restrict)
  user         User                  @relation("CarePortalAccessUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, id])
  @@index([userId])
  @@index([tenantId, customerId])
  @@index([tenantId, subscriptionId])
  @@index([tenantId, inviteId])
}

enum CarePortalInviteStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

enum CarePortalRevokeReason {
  MANUAL
  CUSTOMER_ARCHIVED
  CONTRACT_ENDED
}
