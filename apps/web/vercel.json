{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "node scripts/vercel-build.mjs",
  "ignoreCommand": "[ \"$VERCEL_ENV\" != production ]",
  "git": {
    "deploymentEnabled": {
      "claude/**": false
    }
  },
  "regions": ["iad1"],
  "crons": [
    {
      "path": "/api/internal/maintenance",
      "schedule": "7 6 * * *"
    },
    {
      "path": "/api/internal/ai/drain",
      "schedule": "17 6 * * *"
    }
  ]
}
